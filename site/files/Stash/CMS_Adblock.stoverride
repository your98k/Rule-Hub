name: 'CMS 资源站 去广告'
desc: 'CMS 资源站去广告，清理 m3u8 播放列表内插广告，覆盖 20 个资源站。'
openUrl: 'https://apps.apple.com/app/id6450680262'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/CMSPlayer.png'
author: 'your98k'
category: '去广告'
date: '2026-11-16'
version: '1.0.0'

http:
  mitm:
    - 'm3u8.heimuertv.com'
    - 'm3u8.hmrvideo.com'
    - 'v.cdnlz*.com'
    - 'v.lzcdn*.com'
    - 'vip*.lz-cdn*.com'
    - 'vip.lzcdn*.com'
    - '*.ffzy*.com'
    - '*.rrcdnbf*.com'
    - 'vip.kuaikan*.com'
    - 'bfikuncdn.com'
    - 'play.modujx*.com'
    - 'vod.lyhuicheng.com'
    - 'ukzy.ukubf*.com'
    - '*.wgslsw.com'
    - 'askzycdn.com'
    - 't0.97img.com'
    - '*.bfbfhao.com'
    - 'player.cl9987.com:188'
    - 'v.ykv3.com'
    - '*.3sybf.com'
    - 'bfnxxcdn.com'
    - 'player.huangguam3u.com'
    - 'leshiyuncdn.36s.top'
    - 'cs1.feidaozy.com'
    - 's1.bfengbf.com'
  script:
    - name: cms-adblock
      match: '^https?://m3u8\.(hmrvideo|heimuertv)\.com/play/(.+).m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https?://((?:v\.lzcdn|v\.cdnlz|vip.*\.lz[-]?cdn)\d+\.com)/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https?://(super|svipsvip|vip)\.ffzy[A-Za-z0-9-]+\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https?://c\d+\.rrcdnbf\d+\.com/video/(.+)\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https?://vip\.kuaikan-(cdn|play)\d+\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://bfikuncdn\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://play\.modujx\d+\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://vod\.lyhuicheng\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://ukzy\.ukubf\d+\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://.+\.wgslsw\.com/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://leshiyuncdn\.36s\.top/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://.+\.feidaozy\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://askzycdn\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://.+\.97img\.com/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://.+\.bfbfhao\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://player\.cl9987\.com:188/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://v\.ykv3\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://.+\.3sybf\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://bfnxxcdn\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-adblock
      match: '^https://player\.huangguam3u\.com/.+/hls/.+\.m3u8'
      type: response
      require-body: true
    - name: cms-redirect
      match: '^https?://s\d+\.bfengbf\.com/video'
      type: request

script-providers:
  cms-adblock:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/cms-adblock.js'
    interval: 86400
  cms-redirect:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/cms-redirect.js'
    interval: 86400
