name: '美柚 去广告'
desc: '美柚 去广告，共 11 条规则。'
openUrl: 'https://apps.apple.com/app/id1441978239'
author: 'your98k'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/MeetYou.png'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

rules:
  - 'DOMAIN,ad.seeyouyima.com,REJECT'
  - 'DOMAIN,axxd.xmseeyouyima.com,REJECT'
  - 'DOMAIN,jingqi.youzibuy.com,REJECT'
  - 'DOMAIN,mgo.seeyouyima.com,REJECT'
  - 'DOMAIN,ad-logs.seeyouyima.com,REJECT'
  - 'DOMAIN,ab.seeyouyima.com,REJECT'

http:
  mitm:
    - 'circle.seeyouyima.com'
    - 'circle.xmseeyouyima.com'
    - 'common.seeyouyima.com'
    - 'sub.seeyouyima.com'
    - 'users.seeyouyima.com'
    - 'config-service.seeyouyima.com'
  url-rewrite:
    - '^https?://circle\.(xm)?seeyouyima\.com/v\d/article_recommend\? - reject'
    - '^https?://common\.seeyouyima\.com/v\d/conf_list - reject'
    - '^https?://config-service\.seeyouyima\.com/api/configs/batch - reject-200'
  body-rewrite:
    - '^https?://sub\.seeyouyima\.com/v\d/sub/my_vip response-jq .data={}'
    - '^https?://users\.seeyouyima\.com/v\d/wo\? response-jq del(.data.circle)'
