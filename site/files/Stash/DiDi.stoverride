name: '滴滴出行 去广告'
desc: '滴滴出行 去广告，共 91 条规则。'
openUrl: 'https://apps.apple.com/app/id1482968390'
author: 'your98k'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

rules:
