name: 'TestFlight 解除区域限制'
desc: 'TestFlight 解除区域限制，改写安装请求的 storefrontId。'
openUrl: 'https://apps.apple.com/app/id899247664'
author: 'your98k'
category: '功能增强'
date: '2026-11-16'
version: '1.0.0'

http:
  mitm:
    - 'testflight.apple.com'
  body-rewrite:
    - '^https?://testflight\.apple\.com/v\d/accounts/.+?/install$ request-replace-regex storefrontId\x20:\x20"\d{6}-\d{2},\d{2}", storefrontId:"143441-19,29",'
