name: '📺 BiliBili: 🛡️ ADBlock (Stash 原生参数版)'
desc: '哔哩哔哩：去广告

  自定义去除APP内界面元素'
openUrl: http://boxjs.com/#/app/BiliBili.ADBlock
author: 'ClydeTime[https://github.com/ClydeTime]

  VirgilClyne[https://github.com/VirgilClyne]

  app2smile[https://github.com/app2smile]

  RuCu6[https://github.com/RuCu6]

  Maasea[https://github.com/Maasea]'
homepage: https://biliverse.github.io/guide/ad-block
icon: https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png
category: 🪐 Biliverse
date: '2026-10-17 17:08:28'
version: 0.7.5-native.3
http:
  mitm:
  - biliverse.github.io
  - manga.bilibili.com
  - api.live.bilibili.com
  - api.vc.bilibili.com
  - app.bilibili.com
  - app.biliapi.net
  - app.biliapi.com
  - api.bilibili.com
  - api.biliapi.net
  - grpc.biliapi.net
  - cm.bilibili.com
  - adtrack.qianwen.com
  - tkio-redirect.solar-engine.com
  url-rewrite:
  - ^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words - reject-dict
  - ^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr - reject-dict
  - ^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist - reject-dict
  - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash - reject-dict
  - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash - reject-dict
  - ^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? - reject-dict
  mock:
  - match: ^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$
    base64: AAAAAAA=
    status-code: 200
    headers:
      Content-Type: application/grpc
      grpc-status: '0'
  script:
  - match: ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\?.*)?$
    name: PreferencePanes.Config.ADBlock
    type: request
    require-body: false
  - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?
    name: 📺 BiliBili.ADBlock.request.json
    type: request
    require-body: false
    argument: 'Storage=${args.Storage}&Splash=${args.Splash}&Feed.AD=${args.Feed_AD}&Feed.Activity=${args.Feed_Activity}&Feed.Vertical=${args.Feed_Vertical}&Feed.BlockUpLiveList=${args.Feed_BlockUpLiveList}&Feed.Story=${args.Feed_Story}&Feed.StoryCommercial=${args.Feed_StoryCommercial}&Search.AD=${args.Search_AD}&Search.Tracking=${args.Search_Tracking}&Search.HotSearch=${args.Search_HotSearch}&PGC.AD=${args.PGC_AD}&Xlive.AD=${args.Xlive_AD}&Xlive.RemoveTrackingCallbacks=${args.Xlive_RemoveTrackingCallbacks}&Xlive.RemovePreloadTracking=${args.Xlive_RemovePreloadTracking}&Dynamic.HotTopics=${args.Dynamic_HotTopics}&Dynamic.MostVisited=${args.Dynamic_MostVisited}&Dynamic.MostVisitedLiveOnly=${args.Dynamic_MostVisitedLiveOnly}&Dynamic.AdCard=${args.Dynamic_AdCard}&Dynamic.PersonalAdCard=${args.Dynamic_PersonalAdCard}&View.AD=${args.View_AD}&DM.Command=${args.DM_Command}&DM.Colorful=${args.DM_Colorful}&DM.Airborne=${args.DM_Airborne}&Reply.AD=${args.Reply_AD}&Reply.CommercialLinks=${args.Reply_CommercialLinks}&Reply.SubjectDescriptionCommercial=${args.Reply_SubjectDescriptionCommercial}&Privacy.Tracking=${args.Privacy_Tracking}&Privacy.BlockBiliCommercial=${args.Privacy_BlockBiliCommercial}&Privacy.BlockThirdParty=${args.Privacy_BlockThirdParty}&Privacy.Strict=${args.Privacy_Strict}&LogLevel=${args.LogLevel}'
  - match: ^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/)
    name: 📺 BiliBili.ADBlock.request.json
    type: request
    require-body: false
    argument: 'Storage=${args.Storage}&Splash=${args.Splash}&Feed.AD=${args.Feed_AD}&Feed.Activity=${args.Feed_Activity}&Feed.Vertical=${args.Feed_Vertical}&Feed.BlockUpLiveList=${args.Feed_BlockUpLiveList}&Feed.Story=${args.Feed_Story}&Feed.StoryCommercial=${args.Feed_StoryCommercial}&Search.AD=${args.Search_AD}&Search.Tracking=${args.Search_Tracking}&Search.HotSearch=${args.Search_HotSearch}&PGC.AD=${args.PGC_AD}&Xlive.AD=${args.Xlive_AD}&Xlive.RemoveTrackingCallbacks=${args.Xlive_RemoveTrackingCallbacks}&Xlive.RemovePreloadTracking=${args.Xlive_RemovePreloadTracking}&Dynamic.HotTopics=${args.Dynamic_HotTopics}&Dynamic.MostVisited=${args.Dynamic_MostVisited}&Dynamic.MostVisitedLiveOnly=${args.Dynamic_MostVisitedLiveOnly}&Dynamic.AdCard=${args.Dynamic_AdCard}&Dynamic.PersonalAdCard=${args.Dynamic_PersonalAdCard}&View.AD=${args.View_AD}&DM.Command=${args.DM_Command}&DM.Colorful=${args.DM_Colorful}&DM.Airborne=${args.DM_Airborne}&Reply.AD=${args.Reply_AD}&Reply.CommercialLinks=${args.Reply_CommercialLinks}&Reply.SubjectDescriptionCommercial=${args.Reply_SubjectDescriptionCommercial}&Privacy.Tracking=${args.Privacy_Tracking}&Privacy.BlockBiliCommercial=${args.Privacy_BlockBiliCommercial}&Privacy.BlockThirdParty=${args.Privacy_BlockThirdParty}&Privacy.Strict=${args.Privacy_Strict}&LogLevel=${args.LogLevel}'
