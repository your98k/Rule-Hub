    max-size: 262144
  - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
    argument: 'Storage=${args.Storage}&Splash=${args.Splash}&Feed.AD=${args.Feed_AD}&Feed.Activity=${args.Feed_Activity}&Feed.Vertical=${args.Feed_Vertical}&Feed.BlockUpLiveList=${args.Feed_BlockUpLiveList}&Feed.Story=${args.Feed_Story}&Feed.StoryCommercial=${args.Feed_StoryCommercial}&Search.AD=${args.Search_AD}&Search.Tracking=${args.Search_Tracking}&Search.HotSearch=${args.Search_HotSearch}&PGC.AD=${args.PGC_AD}&Xlive.AD=${args.Xlive_AD}&Xlive.RemoveTrackingCallbacks=${args.Xlive_RemoveTrackingCallbacks}&Xlive.RemovePreloadTracking=${args.Xlive_RemovePreloadTracking}&Dynamic.HotTopics=${args.Dynamic_HotTopics}&Dynamic.MostVisited=${args.Dynamic_MostVisited}&Dynamic.MostVisitedLiveOnly=${args.Dynamic_MostVisitedLiveOnly}&Dynamic.AdCard=${args.Dynamic_AdCard}&Dynamic.PersonalAdCard=${args.Dynamic_PersonalAdCard}&View.AD=${args.View_AD}&DM.Command=${args.DM_Command}&DM.Colorful=${args.DM_Colorful}&DM.Airborne=${args.DM_Airborne}&Reply.AD=${args.Reply_AD}&Reply.CommercialLinks=${args.Reply_CommercialLinks}&Reply.SubjectDescriptionCommercial=${args.Reply_SubjectDescriptionCommercial}&Privacy.Tracking=${args.Privacy_Tracking}&Privacy.BlockBiliCommercial=${args.Privacy_BlockBiliCommercial}&Privacy.BlockThirdParty=${args.Privacy_BlockThirdParty}&Privacy.Strict=${args.Privacy_Strict}&LogLevel=${args.LogLevel}'
    max-size: 262144
script-providers:
  PreferencePanes.Config.ADBlock:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/config.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.request.json:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/request.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.response.json:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/response.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.response.grpc:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/response.bundle.js
    interval: 86400
arguments-version: 1
arguments:
  Splash:
    type: switch
    title: '[开屏] 去除广告'
    description: 是否启用此处修改
    default: true
  Feed_AD:
    type: switch
    title: '[推荐] 去除广告'
    description: 是否启用此处修改
    default: true
  Feed_Activity:
    type: switch
    title: '[推荐] 去除“活动大图”'
    description: 是否启用此处修改
    default: false
  Feed_Vertical:
    type: switch
    title: '[推荐] 去除竖屏视频'
    description: 是否启用此处修改
    default: false
  Feed_BlockUpLiveList:
    type: input
    title: '[推荐] 屏蔽UP主直播推广'
    description: 填 0 表示不屏蔽；仅支持单个数字 UID。上游多 UID 会触发类型错误，暂不开放。
    default: 0
    value-type: integer
    minimum: 0
    maximum: 9007199254740991
    required: true
  Feed_Story:
    type: switch
    title: '[首页] 去除短视频流广告'
    description: 是否启用此处修改
    default: true
  Feed_StoryCommercial:
    type: switch
    title: '[首页] 去除Story商业按钮'
    description: 移除Story中的“助TA必火”等商业推广按钮，不删除视频卡片。
    default: true
  Search_AD:
    type: switch
    title: '[搜索] 去除广告'
    description: 是否启用此处修改
    default: true
  Search_Tracking:
    type: switch
    title: '[搜索] 移除响应跟踪参数'
    description: 清理SearchAll结果对象及跳转链接中的trackid、report_flow_data，不修改播放签名和预加载数据。
    default: false
  Search_HotSearch:
    type: switch
    title: '[搜索] 去除“热搜”'
    description: 是否启用此处修改
    default: true
  PGC_AD:
    type: switch
    title: '[番剧电影] 去除广告'
    description: 是否启用此处修改
    default: true
  Xlive_AD:
    type: switch
    title: '[直播] 去除广告'
    description: 是否启用此处修改
    default: true
  Xlive_RemoveTrackingCallbacks:
    type: switch
    title: '[直播] 移除推荐回调'
    description: 移除直播推荐卡的show_callback与click_callback；可能影响推荐状态和翻页。
    default: false
  Xlive_RemovePreloadTracking:
    type: switch
    title: '[直播] 移除预载链接trackid'
    description: 只移除直播small_card_v1.subtitle_style.link中的trackid，保留播放、清晰度和会话参数。
    default: false
  Dynamic_HotTopics:
    type: switch
    title: '[动态] 去除“热门话题”'
    description: 是否启用此处修改
    default: true
  Dynamic_MostVisited:
    type: switch
    title: '[动态] 去除“最常访问”'
    description: 是否启用此处修改
    default: false
  Dynamic_MostVisitedLiveOnly:
    type: switch
    title: '[动态] “最常访问”仅显示直播'
    description: 是否启用此处修改
    default: false
  Dynamic_AdCard:
    type: switch
    title: '[动态] 去除广告卡片'
    description: 是否启用此处修改
    default: true
  Dynamic_PersonalAdCard:
    type: switch
    title: '[动态] 去除个人流广告卡片'
    description: 过滤DynAllPersonal与DynVideoPersonal中的cardType=15；当前抓包尚无广告阳性样本。
    default: true
  View_AD:
    type: switch
    title: '[视频] 去除播放页广告'
    description: 是否启用此处修改
    default: true
  DM_Command:
    type: switch
    title: '[弹幕] 去除交互式弹幕'
    description: 是否启用此处修改
    default: false
  DM_Colorful:
    type: switch
    title: '[弹幕] 替换彩色弹幕'
    description: 是否启用此处修改
    default: false
  DM_Airborne:
    type: switch
    title: '[弹幕] 空降助手'
    description: 是否启用此处修改
    default: true
  Reply_AD:
    type: switch
    title: '[评论] 去除广告'
    description: 是否启用此处修改
    default: true
  Reply_CommercialLinks:
    type: switch
    title: '[评论] 禁用普通评论商业跳转'
    description: 保留普通评论正文与回复树，仅移除已识别商品链接的可点击映射。
    default: false
  Reply_SubjectDescriptionCommercial:
    type: switch
    title: '[评论] 隐藏编辑器商品能力'
    description: 移除SubjectDescription中的商品与商业助手按钮(type 5/8)；当前抓包中它们均为隐藏状态。
    default: false
  Privacy_Tracking:
    type: switch
    title: '[隐私] 移除响应链接跟踪参数'
    description: 清理推荐、Story 与评论跳转链接中的高置信度归因参数，保留目标和界面功能参数。
    default: true
  Privacy_BlockBiliCommercial:
    type: switch
    title: '[隐私] 阻止B站商业上报'
    description: 本地成功响应conversion/mobile/v2与fees/wise，阻止相关请求上传。
    default: true
  Privacy_BlockThirdParty:
    type: switch
    title: '[隐私] 阻止第三方广告归因'
    description: 本地响应已确认的千问与Solar Engine广告展示、点击和归因请求。
    default: true
  Privacy_Strict:
    type: switch
    title: '[隐私] 严格模式'
    description: 同时启用响应跟踪清理、商业链接与上报阻断，并移除直播show/click callback；可能影响跳转、推荐和翻页。
    default: false
  Storage:
    type: select
    title: '[储存] 配置来源'
    description: Argument：本页原生参数优先；PersistentStore：已有持久化/BoxJS配置优先。
    default: Argument
    options:
    - value: Argument
      label: Stash 原生参数优先
    - value: PersistentStore
      label: PersistentStore / BoxJS 优先
  LogLevel:
    type: select
    title: '[调试] 日志等级'
    description: 选择脚本日志的输出等级，低于所选等级的日志将全部输出。
    default: WARN
    options:
    - value: 'OFF'
      label: 关闭
    - value: ERROR
      label: 错误
    - value: WARN
      label: 警告
    - value: INFO
      label: 信息
    - value: DEBUG
      label: 调试
    - value: ALL
      label: 全部
