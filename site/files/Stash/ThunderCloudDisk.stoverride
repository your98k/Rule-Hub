name: '迅雷 去广告'
desc: |-
  迅雷 去广告，共 2 条规则。
openUrl: 'https://apps.apple.com/app/id1509021336'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ThunderCloudDisk.png'
author: 'your98k'
category: '去广告'
date: '2026-11-16'
version: '1.0.0'

http:
  mitm:
    - 'conf-m-ssl.xunlei.com'
    - 'api-shoulei-ssl.xunlei.com'
    - 'xluser-ssl.xunlei.com'
  body-rewrite:
    - '^https://api-shoulei-ssl\.xunlei\.com/flowhub/v1/slots:batchGet$ response-jq .slots |= map(select(.id == "xl_ios_mytab_vipicon" or (.native.assets.title.text.value? and (.native.assets.title.text.value | . == "清理助手" or . == "云盘容量" or . == "远程设备"))))'
  script:
    - name: 'thunderclouddisk-0'
      match: '^https://xluser-ssl\.xunlei\.com/xluser\.core\.login/v3/getuserinfo'
      type: response
      require-body: true
      max-size: 10485760
      timeout: 10
      engine: auto

script-providers:
  thunderclouddisk-0:
    url: 'https://raw.githubusercontent.com/Marol62926/MarScrpt/main/xunlei.js'
    interval: 86400
