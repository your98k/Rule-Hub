name: '航旅纵横 去广告'
desc: |-
  航旅纵横 去广告，共 3 条规则。
openUrl: 'https://apps.apple.com/app/id458527711'
author: 'your98k'
category: '去广告'
date: '2026-11-16'
version: '1.0.0'

http:
  mitm:
    - 'umerp.umetrip.com'
    - 'umerp.umetrip.com.cn'
    - 'home.umetrip.com'
    - 'bkclient.umetrip.com.cn'
    - 'discardrp.umetrip.com'
    - 'startup.umetrip.com'
    - 'oss.umetrip.com'
    - 'umehome.umetrip.com'
    - 'sns.umetrip.com'
    - 'appmsg.umetrip.com'
  url-rewrite:
    - '^https?://(discardrp|startup)\.umetrip\.com/gateway/api/umetrip/native - reject'
    - '^https?://oss\.umetrip\.com/fs/advert/polite - reject-dict'
  script:
    - name: 'umetrip-0'
      match: '^https?://(bkclient|umerp|home|umehome|sns|appmsg)\.umetrip\.com(\.cn)?/gateway/api/umetrip/native(?:\?.*)?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 30
      engine: auto

script-providers:
  umetrip-0:
    url: 'https://raw.githubusercontent.com/xingjiu29/Umetrip/main/umetrip.js'
    interval: 86400
