name: '波点音乐 去广告'
desc: |-
  波点音乐 去广告，共 19 条规则。
openUrl: 'https://apps.apple.com/app/id1635932798'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/BodianMusic.png'
author: 'your98k'
category: '去广告'
date: '2026-11-16'
version: '1.0.0'

http:
  mitm:
    - '39.156.12*.*:443'
    - '39.156.121.20:443'
    - '39.156.121.21:443'
    - '39.156.121.60:80'
    - '39.156.121.65:443'
    - '39.156.121.*:443'
    - '39.156.123.46'
    - '39.156.123.46:443'
    - '101.42.133.54:443'
    - '111.30.171.170:443'
    - '*.kuwo.*'
    - '*.l.qq.com'
    - 'ab-bodian.kuwo.cn'
    - 'ab-bodian.kuwo.cn:443'
    - 'ad.tencentmusic.com'
    - 'bd-api.kuwo.cn'
    - 'bd-api.kuwo.cn:443'
    - 'bd-api.kuwo.com'
    - 'bodianimgcdn.kuwo.cn'
    - 'h5app.kuwo.cn'
    - 'h5s.kuwo.cn'
    - 'xs.gdt.qq.com'
  url-rewrite:
    - '^https://ad\.tencentmusic\.com/config/uni - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/(play|service|advert)/advert/ - reject-dict'
    - '^https?://h5s\.kuwo\.cn/m/bd_launch_popup/index - reject'
    - '^https://bd-api\.kuwo\.cn/api/service/banner/ - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/ucenter/vip/give/config\? - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/service/home/module\?.*&moduleId=6 - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/advert/earning/app/config\? - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/pay/vip/lowPriceText\? - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/service/global/config/vipEnter\? - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/popup/ - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/pay/vip/invitation/swell/popup\? - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/service/version/popup\? - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/pay/vip/invitation/assist/popup\? - reject-dict'
    - '^https://bd-api\.kuwo\.cn/api/pay/h5/common/popup\? - reject-dict'
  body-rewrite:
    - '^https://bd-api\.kuwo\.cn/api/service/home/index\? response-jq .data.moduleList |= map(select(.type | tostring | (. != "8" and . != "5" and . != "1" and . != "9" and . != "6")))'
    - '^https://bd-api\.kuwo\.cn/api/service/music/recommendList\? response-jq .data.musicList[] |= del(.showAd)'
    - '^https://bd-api\.kuwo\.cn/api/service/resource/recommend\? response-jq .data.resourceList[] |= del(.resource)'
    - '^https://bd-api\.kuwo\.cn/api/voice/room/v2/sidebar response-jq (.data) = {}'
  script:
    - name: 'bodianmusic-0'
      match: '^https?://(?:(?:bd-api|h5app|bodianyin|ab-bodian)\.kuwo\.cn/(?:api/(?:ucenter/users/(?:pub|login)|play/(?:music/v2/(?:audioUrl|checkRight)|advert/info)|service/(?:music/(?:info|download/(?:info|config))|home/module|global/config/(?:scene|vipEnter)|banner/positions|advert/config)|search/topic/word/list|pay/(?:vip/(?:invitation/(?:assist/popup|swell)|lowPriceText)|sp/actVip|audition/url)|advert/free/config|popup/start/info|abtest/ui/info|rec/feed)|abtest/ui/info)|us\.l\.qq\.com/exapp|xs\.gdt\.qq\.com/style_factory/template_list)'
      type: response
      require-body: true
      max-size: 10485760
      timeout: 60
      engine: auto

script-providers:
  bodianmusic-0:
    url: 'https://raw.githubusercontent.com/WeiGiegie/666/main/bdyy.js'
    interval: 86400
