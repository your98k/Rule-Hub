#!name=虎扑去广告（本地 Mock 精简版）
#!desc=群友方案的 Loon 原生适配。仅处理 goblin.hupu.com 的 interfaceAd/getOther 广告接口，本地返回 HTTP 200 无广告 JSON，无需等待该接口上游响应，无远程脚本。需启用 MitM 并安装、完全信任 Loon CA；启用前停用旧虎扑插件及重复重写。需要 Loon 3.5.1(978)+。未实机验证，不保证移除全部广告或解决所有启动等待。
#!author=群友投稿（未署名）；Loon 适配：ChatGPT
#!tag=去广告
#!openUrl=https://apps.apple.com/app/id906632439
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/HUPU.png
#!loon_version=3.5.1(978)
#!date=2026-11-03

# 与 Stash 本地 Mock 精简版保持相同接口范围，不包含个人页、热榜等净化。
[Rule]
DOMAIN-SUFFIX,goblin.hupu.com,DIRECT

# 官方说明：response.body.mock 虽写在 response 阶段，仍会在请求发往上游前生成响应。
# Mock 的 Body 参数使用原始字符串，不直接传入 JSON 对象。
# 语法来源：https://nsloon.app/docs/Rewrite/rewrite_v2/
[Rewrite]
response if ${url} ~= /^https?:\/\/goblin\.hupu\.com\/\d+\/\d+(?:\.\d+)*\/interfaceAd\/getOther(?:\/|\?|$)/i then response.body.mock("json", `{"ad_code":-41,"show_type":0,"ads":[]}`, 200)

[MitM]
hostname = goblin.hupu.com
