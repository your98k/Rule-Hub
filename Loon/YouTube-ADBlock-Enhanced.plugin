#!name = YouTube 去广告增强版
#!desc = 12 项参数：10 个开关 + 字幕/歌词翻译，含首页 Sponsored 补强；需启用改写与 MitM。与旧 YouTube 插件二选一。
#!author = Maasea[https://github.com/Maasea] gholts[https://github.com/gholts] RuCu6[https://github.com/RuCu6] VirgilClyne[https://github.com/VirgilClyne] Hey-sayiwanna[https://github.com/Hey-sayiwanna]
#!homepage = https://github.com/your98k/Rule-Hub
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!tag = 去广告,YouTube
#!system = iOS,iPadOS
#!loon_version = 3.5.1(978)
#!date = 2026-10-30
#!version = 1.2.0

[Argument]
autoHd = switch,false,type=boolean,tag=自动最高画质,desc=自动选择 YouTube 最高画质
blockAi = switch,false,type=boolean,tag=隐藏智能助手,desc=隐藏 YouTube 智能助手入口
blockGames = switch,false,type=boolean,tag=隐藏内置游戏,desc=隐藏 YouTube 游戏服务
blockShorts = switch,false,type=boolean,tag=隐藏短片按钮,desc=隐藏底栏 Shorts 按钮
blockStore = switch,false,type=boolean,tag=隐藏商品橱窗,desc=隐藏视频下方及主页商品推广
blockUpload = switch,false,type=boolean,tag=隐藏上传按钮,desc=隐藏底栏上传按钮
blockVerticalLive = switch,false,type=boolean,tag=隐藏竖屏直播,desc=隐藏主页竖屏直播
jumpAhead = switch,false,type=boolean,tag=开启精彩跳转,desc=解锁 Premium Jump Ahead 入口；仅客户端 UI
onTheGo = switch,false,type=boolean,tag=开启通勤模式,desc=解锁 Premium On-the-go 入口；仅客户端 UI
homeFeedPatch = switch,true,type=boolean,tag=首页信息流补强,desc=清理首页 Sponsored 卡片、空壳和分隔线；误删可关闭
captionLang = select,"简体中文","关闭翻译","繁體中文","英语","日语","韩语",type=string,tag=字幕翻译语言,desc=使用 YouTube 自带翻译轨；关闭则不新增
lyricLang = select,"简体中文","关闭翻译","繁體中文","英语","日语","韩语",type=string,tag=歌词翻译语言,desc=调用 Google Translate 翻译歌词；关闭则不发送歌词

[Rewrite]
request if ${url} ~= /^https?:\/\/s\.youtube\.com\/api\/stats\/ads/i then reject(404)
request if ${url} ~= /^https?:\/\/www\.youtube\.com\/(?:pagead|pcs)\//i then reject(404)

[Script]
request if ${url} ~= /^https?:\/\/(?:(?:youtubei\.googleapis\.com\/youtubei\/v1\/(?:player\/ad_break|log_event))|(?:[A-Za-z0-9_-]+\.googlevideo\.com\/(?:initplayback|videoplayback)))(?:\?.*)?$/i then script("https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/Youtube/YouTube-ADBlock-Enhanced.request.js", {${autoHd}}) with tag="YouTube request", timeout=15, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/Youtube/YouTube-ADBlock-Enhanced.response.js", {${autoHd}, ${blockAi}, ${blockGames}, ${blockShorts}, ${blockStore}, ${blockUpload}, ${blockVerticalLive}, ${jumpAhead}, ${onTheGo}, ${homeFeedPatch}, ${captionLang}, ${lyricLang}}) with tag="YouTube response", timeout=30, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/Youtube/YouTube-ADBlock-Enhanced.key.js") with tag="YouTube key", timeout=20, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/[A-Za-z0-9_-]+\.googlevideo\.com\/initplayback(?:\?.*)?$/i then script("https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/Youtube/YouTube-ADBlock-Enhanced.ump.js", {${autoHd}, ${blockAi}, ${blockGames}, ${blockShorts}, ${blockStore}, ${blockUpload}, ${blockVerticalLive}, ${jumpAhead}, ${onTheGo}, ${homeFeedPatch}, ${captionLang}, ${lyricLang}}) with tag="YouTube UMP", timeout=30, requires_body=true, binary_body_mode=true

[Mitm]
hostname = rr*.googlevideo.com, s.youtube.com, www.youtube.com, youtubei.googleapis.com
