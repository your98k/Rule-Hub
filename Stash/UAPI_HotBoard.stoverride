name: 'UAPI热榜聚合'
desc: '多平台热榜定时推送，可选平台与榜单条数。'
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/Other/FlameFill.png'
date: '2026-10-02 12:00'
openUrl: 'https://uapis.cn/hotboard'
category: '定时任务'
# 由 Loon 插件自动转换：UAPI_HotBoard.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：sooyaaabo[https://github.com/sooyaaabo]
arguments-version: 1
arguments:
  uapi_cron:
    type: input
    title: '定时参数'
    default: "0 9 * * *"
    description: cron 表达式，默认「0 9 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  uapi_type:
    type: input
    title: '热榜平台'
    default: ""
    description: 平台标识，多个用逗号分隔，名称需与接口一致。写错或不支持的平台不会返回数据。
  uapi_top:
    type: input
    title: '榜单条数'
    default: ""
    description: 榜单条数，需为整数。填太大可能触发接口限流。
  uapi_api:
    type: input
    title: 'UAPI Token'
    default: ""
    description: 接口令牌，留空则走公共接口。公共接口有限速，可能失败或返回不全。
cron:
  script:
    - name: 'UAPI_hotboard'
      cron: '${args.uapi_cron}'
      timeout: 60
script-providers:
  UAPI_hotboard:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/UAPI.hotboard.js'
    interval: 86400
