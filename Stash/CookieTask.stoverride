name: 'Cookie & Task'
desc: |-
  定时每日签到任务，按需开启相应功能即可。
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: https://raw.githubusercontent.com/fishdown/Icon/master/app/cookie.png
date: '2026-10-02 12:00'
category: '定时任务'
# 由 Loon 插件自动转换：CookieTask.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：FoKit[https://github.com/FoKit], GoodHolidays[https://github.com/GoodHolidays], ClydeTime[https://github.com/ClydeTime], MaYIHEI[https://github.com/MaYIHEI], sooyaaabo[https://github.com/sooyaaabo]
arguments-version: 1
arguments:
  Cookie_WeChatPay:
    type: switch
    title: '[微信支付有优惠]领金币Cookie'
    default: false
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Task_WeChatPay:
    type: switch
    title: '[微信支付有优惠]领金币Task'
    default: false
    description: 开关：开启后执行对应自动任务；关闭则不再执行，不影响已保存的 Cookie。
  Cron_WeChatPay:
    type: input
    title: '[微信支付有优惠]定时参数Cron'
    default: "0 0 9 * * *"
    description: cron 表达式，默认「0 0 9 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  Cookie_Weibo:
    type: switch
    title: '[微博]每日签到Cookie'
    default: false
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Task_Weibo:
    type: switch
    title: '[微博]每日签到Task'
    default: false
    description: 开关：开启后执行对应自动任务；关闭则不再执行，不影响已保存的 Cookie。
  Cron_Weibo:
    type: input
    title: '[微博]定时参数Cron'
    default: "0 0 9 * * *"
    description: cron 表达式，默认「0 0 9 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  Cookie_WeiboTalk:
    type: switch
    title: '[微博超话]每日签到Cookie'
    default: false
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Task_WeiboTalk:
    type: switch
    title: '[微博超话]每日签到Task'
    default: false
    description: 开关：开启后执行对应自动任务；关闭则不再执行，不影响已保存的 Cookie。
  Cron_WeiboTalk:
    type: input
    title: '[微博超话]定时参数Cron'
    default: "0 0 9 * * *"
    description: cron 表达式，默认「0 0 9 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  Cookie_BilibiliApp:
    type: switch
    title: '[哔哩哔哩App]每日等级任务Cookie'
    default: false
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Cookie_BilibiliQRCode:
    type: switch
    title: '[哔哩哔哩QR Code]每日等级任务Cookie'
    default: false
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Task_Bilibili:
    type: switch
    title: '[哔哩哔哩]每日等级任务Task'
    default: false
    description: 开关：开启后执行对应自动任务；关闭则不再执行，不影响已保存的 Cookie。
  Cron_Bilibili:
    type: input
    title: '[哔哩哔哩]定时参数Cron'
    default: "0 0 9 * * *"
    description: cron 表达式，默认「0 0 9 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  Cookie_WPS:
    type: switch
    title: '[WPS]每日签到Cookie'
    default: false
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Task_WPS:
    type: switch
    title: '[WPS]每日签到Task'
    default: false
    description: 开关：开启后执行对应自动任务；关闭则不再执行，不影响已保存的 Cookie。
  Cron_WPS:
    type: input
    title: '[WPS]定时参数Cron'
    default: "0 0 9 * * *"
    description: cron 表达式，默认「0 0 9 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
http:
  mitm:
    - 'payapp.weixin.qq.com'
    - 'api.weibo.cn'
    - 'cm.bilibili.com'
    - 'm.bilibili.com'
    - 'personal-act.wps.cn'
    - 'app.bilibili.com'
  script:
    - name: 'wechat_pay_coupon'
      match: '^https://payapp\.weixin\.qq\.com/(coupon-center-user/home/login|coupon-center-award/award/detail)'
      type: 'response'
    - name: 'WeiboCookieTask'
      match: '^https?://api\.weibo\.cn/\d/users/show'
      type: 'request'
    - name: 'weibotalk_cookie'
      match: '^https://api\.weibo\.cn/2/(statuses/container_timeline_topicsub|page/button)'
      type: 'request'
    - name: 'BiliBiliDailyBonus'
      match: '^https?://app\.bilibili\.com/x/resource/fingerprint\?'
      type: 'request'
    - name: 'BiliBiliDailyBonus'
      match: '^https?://app\.bilibili\.com/x/resource/fingerprint\?'
      type: 'response'
    - name: 'wps_cookie'
      match: '^https://personal-act\.wps\.cn/activity-rubik/activity/page_info'
      type: 'request'
cron:
  script:
    - name: 'wechat_pay_coupon'
      cron: '0 9 * * *'
      timeout: 60
    - name: 'WeiboCookieTask'
      cron: '0 9 * * *'
      timeout: 60
    - name: 'weibotalk'
      cron: '0 9 * * *'
      timeout: 60
    - name: 'BiliBiliDailyBonus'
      cron: '0 9 * * *'
      timeout: 60
    - name: 'wps'
      cron: '0 9 * * *'
      timeout: 60
script-providers:
  wechat_pay_coupon:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/wechat_pay_coupon.js'
    interval: 86400
  WeiboCookieTask:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/WeiboCookieTask.js'
    interval: 86400
  weibotalk_cookie:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/weibotalk.cookie.js'
    interval: 86400
  weibotalk:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/weibotalk.js'
    interval: 86400
  BiliBiliDailyBonus:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/BiliBiliDailyBonus.js'
    interval: 86400
  wps_cookie:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/wps.cookie.js'
    interval: 86400
  wps:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/wps.js'
    interval: 86400
