name: '大麦 去广告'
desc: |-
  移植 loonlab 插件仓库 DaMai.lpx：2 条 url-rewrite、3 条 body-rewrite，全部为 Stash 原生声明式配置。
  覆盖 1 个域名，使用前请在 Stash 信任 MitM CA。
  来源：loonlab 插件仓库 DaMai.lpx。
openUrl: 'https://apps.apple.com/app/id491108899'
author: 'loonlab · Loon→Stash 原生适配'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

http:
  mitm:
    - 'acs.m.taobao.com'
  url-rewrite:
    - '^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.home\.welcome/ - reject-dict'
    - '^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.popup\.get/ - reject-dict'
  body-rewrite:
    - '^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.user\.my\.content\.get/ response-jq del(.data.banner, .data.performFilmVip.userProfitList)'
    - '^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.mypage\.feed/ response-jq del(.data.feedCard)'
    - '^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.aristotle\.get/ response-jq del(.data.data.top.keywords)'
