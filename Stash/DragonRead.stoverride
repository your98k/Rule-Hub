name: '番茄小说去广告'
desc: |-
  移除番茄小说开屏广告、章末/文末广告、听书页广告、悬浮福利组件与底栏多余标签。
  原生 Stash 覆写：规则前插 + no-track，不依赖 mitm、不加载脚本、不改其它配置。
  规则来源：Loon 插件 DragonRead_remove_ads（可莉🅥，kelee.one，2026-10-02）逐条等价迁移。
author: '可莉🅥'
homepage: 'https://hub.kelee.one'
icon: 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DragonRead.png'
openUrl: 'https://apps.apple.com/app/id1468454200'
category: '去广告'
version: '2026-11-15'

rules:
  # —— 广告投放与归因 SDK ——
  - 'DOMAIN,zlink.ugsdk.cn,REJECT,no-track'
  - 'DOMAIN,ads3-normal.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,ads5-normal.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,vcs.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,mssdk.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,effect.snssdk.com,REJECT,no-track'
  - 'DOMAIN,vas.snssdk.com,REJECT,no-track'
  - 'DOMAIN,security.snssdk.com,REJECT,no-track'
  - 'DOMAIN,timon.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,ma.zijieapi.com,REJECT,no-track'

  # —— 曝光/行为埋点上报 ——
  - 'DOMAIN,mon.toutiaocloud.com,REJECT,no-track'
  - 'DOMAIN,mon.toutiaocloud.net,REJECT,no-track'
  - 'DOMAIN,mon3-misc.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,mon11-misc.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,mon11-misc-lq.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,log3-applog.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,log5-applog.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,rtlog3-applog.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,rtlog5-applog.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,abtest3-misc.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,feedback-c.zijieapi.com,REJECT,no-track'

  # —— 抖音/直播引流入口 ——
  - 'DOMAIN,webcast-open.douyin.com,REJECT,no-track'
  - 'DOMAIN,p3-webcast-sign.douyinpic.com,REJECT,no-track'
  - 'DOMAIN,p11-webcast-sign.douyinpic.com,REJECT,no-track'
  - 'DOMAIN,lf-normal-gr-sourcecdn.bytegecko.com,REJECT,no-track'
  - 'DOMAIN,lf-webcast-gr-sourcecdn.bytegecko.com,REJECT,no-track'

  # —— 素材/小游戏/热更新下发 ——
  - 'DOMAIN,p3-developer.bytemaimg.com,REJECT,no-track'
  - 'DOMAIN,gecko3.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,gecko5.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,minigame3-normal.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,minigame5-normal.zijieapi.com,REJECT,no-track'
  - 'DOMAIN,is.snssdk.com,REJECT,no-track'
  - 'DOMAIN,is-lq.snssdk.com,REJECT,no-track'
  - 'DOMAIN,i.snssdk.com,REJECT,no-track'
