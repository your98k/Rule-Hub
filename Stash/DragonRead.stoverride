name: '番茄小说去广告'
desc: |-
  番茄小说去广告：域名拦截 + 广告路径秒拒 + 正文广告清理。
  需 MitM；与「红果短剧」同开为完全体。
author: 'TomCatXue / 可莉🅥'
homepage: 'https://github.com/TomCatXue/MyCookieCenter'
icon: 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DragonRead.png'
openUrl: 'https://apps.apple.com/app/id1468454200'
category: '去广告'
version: '2026-11-15'

rules:
  # 穿山甲 / 广告联盟 SDK
  - 'DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,no-track'
  - 'DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,no-track'
  - 'DOMAIN-SUFFIX,pangle.io,REJECT,no-track'
  - 'DOMAIN,zlink.ugsdk.cn,REJECT,no-track'

  # 头条系广告位
  - 'DOMAIN,ads.toutiao.com,REJECT,no-track'
  - 'DOMAIN,ad.toutiao.com,REJECT,no-track'
  - 'DOMAIN,ad.zijieapi.com,REJECT,no-track'
  - 'DOMAIN-KEYWORD,ads3-normal,REJECT,no-track'
  - 'DOMAIN-KEYWORD,ads5-normal,REJECT,no-track'
  - 'DOMAIN-KEYWORD,-ad-sign.byteimg.com,REJECT,no-track'
  - 'DOMAIN-KEYWORD,-ad-sign.fqnovelpic.com,REJECT,no-track'

  # 埋点 / 日志上报
  - 'DOMAIN-SUFFIX,toutiaocloud.com,REJECT,no-track'
  - 'DOMAIN-SUFFIX,toutiaocloud.net,REJECT,no-track'
  - 'DOMAIN-KEYWORD,-applog.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,mon11-misc.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,mon11-misc-lq.fqnovel.com,REJECT,no-track'
  - 'DOMAIN,mon3-misc.fqnovel.com,REJECT,no-track'

  # 抖音引流入口
  - 'DOMAIN,webcast-open.douyin.com,REJECT,no-track'

http:
  mitm:
    - '*.fqnovel.com'
    - '*.fqnovelpic.com'
    - '*.novelreading.com'

  url-rewrite:
    # 开屏广告（两代路径）
    - '^https?://.*\.fqnovel\.com/api/ad/splash/ - reject-dict'
    - '^https?://.*\.fqnovel\.com/api/ad/v\d+/splash/ - reject-dict'
    # 横幅 / 激励 / 不感兴趣 / 上报 / 直播推广
    - '^https?://.*\.fqnovel\.com/api/ad/v\d+/(aggregate|banner|inspire|dislike|report|live_cmm) - reject-dict'
    - '^https?://.*\.fqnovel\.com/api/ad/union/sdk/get_ads - reject-dict'
    # 悬浮活动部件、计时器金币球、激励视频弹窗
    - '^https?://.*\.fqnovel\.com/luckycat/crossover/v\d+/get_timer_widget - reject-dict'
    - '^https?://.*\.fqnovel\.com/polaris/task/incentive_ad_again_info - reject-dict'
    - '^https?://.*\.fqnovel\.com/luckycat/novel/page/ios_task - reject-dict'

  body-rewrite:
    # 正文广告字段递归清理
    - '^https?://.*\.fqnovel\.com/(reading/reader/full/|reading/reader/batch_full/|api/novel/book/reader/content/) response-jq walk(if type == "object" then (del(.ad_info)|del(.chapter_ad)|del(.flow_ad_list)|del(.flow_ad)|del(.ad_card)|del(.ad_unit)|del(.ad_style)|del(.ad_track)|del(.reward_video)|del(.insert_ad)|del(.banner_ad)|del(.page_ad)|del(.tips_ad)|del(.ad_reward)|del(.bottom_ad)|(if has("need_ad") then .need_ad = false else . end)|(if has("show_ad") then .show_ad = 0 else . end)|(if has("has_ad") then .has_ad = 0 else . end)|(if has("is_ad") then .is_ad = 0 else . end)) else . end)'
