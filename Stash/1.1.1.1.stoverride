name: '1.1.1.1 with WARP'
desc: |-
  WARP检测面板与节点提取，点击下方主页链接前往配置1.1.1.1的BoxJs配置。
author: 'VirgilClyne[https://github.com/VirgilClyne], I-am-R-E[https://github.com/I-am-R-E]'
homepage: 'https://loonlab.103516.xyz/Plugin/'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/1.1.1.1-01.png'
date: '2026-11-02 21:00'
open-url: 'https://itunes.apple.com/app/id1423538627'
category: #!replace
  - '功能增强'
# 由 Loon 插件自动转换：1.1.1.1.lpx
# 上游主页：https://loonlab.103516.xyz/Plugin/
# 原作者：VirgilClyne[https://github.com/VirgilClyne], I-am-R-E[https://github.com/I-am-R-E]
http:
  mitm:
    - 'api.cloudflareclient.com'
    - 'zero-trust-client.cloudflareclient.com'
  script:
    - name: 'a_1_1_1_1_request'
      match: '^https?://(api|zero-trust-client)\.cloudflareclient\.com/(.*)/reg/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$'
      type: 'request'
    - name: 'a_1_1_1_1_response'
      match: '^https?://(api|zero-trust-client)\.cloudflareclient\.com/(.*)/reg/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$'
      type: 'response'
    - name: 'a_1_1_1_1_request'
      match: '^https?://(api|zero-trust-client)\.cloudflareclient\.com/(.*)/reg/t\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$'
      type: 'request'
    - name: 'a_1_1_1_1_response'
      match: '^https?://(api|zero-trust-client)\.cloudflareclient\.com/(.*)/reg/t\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$'
      type: 'response'
script-providers:
  a_1_1_1_1_request:
    url: 'https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.request.js'
    interval: 86400
  a_1_1_1_1_response:
    url: 'https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.response.js'
    interval: 86400
