name: 'GitHub Raw 走 CDN'
desc: '把 raw.githubusercontent.com 的请求自动改写到可用的 CDN 加速地址。'
openUrl: 'https://github.com'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/GitHub-01.png'
author: 'your98k'
category: '功能增强'
date: '2026-11-16'
version: '1.0.0'

http:
  mitm:
    - 'raw.githubusercontent.com'
  script:
    - name: 'gh-raw-cdn'
      match: '^https?://raw\.githubusercontent\.com/.+'
      type: request
      timeout: 5
      engine: auto

script-providers:
  gh-raw-cdn:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/GitHubRawCDN.js'
    interval: 86400
