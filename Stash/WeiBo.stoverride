name: '微博'
desc: |-
  微博全面净化
author: 'RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200], zmqcherish[https://github.com/zmqcherish], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/WeiBo.png'
date: '2026-10-19 15:00'
open-url: 'https://apps.apple.com/app/id350962117'
category: #!replace
  - '去广告'
# 由 Loon 插件自动转换：WeiBo.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200], zmqcherish[https://github.com/zmqcherish], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
arguments-version: 1
arguments:
  MainTabFilter:
    type: switch
    title: '顶部 Tab 过滤'
    default: true
http:
  url-rewrite:
    - '^https?://m?api\.weibo\.c(n|om)/2/logservice/service\? - reject'
    - '^https://m?api\.weibo\.c(n|om)/2/(?:ug/checkin/list|push/daily|push/info) - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/!/live/media_homelist\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/comments/bullet_screens\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/photo/info\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/statuses/(?:container_positive|push_info) - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/vote/get_vote_detail\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/!/chaohua/discovery/home_bottom/switch\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/!/huati/(?:discovery_home_bottom_channels|discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/!/wbox/\w+/(?:home_bottom_modal|interest_category) - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/search/(?:container_discover|finder_nav_polling)\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/hot/hours_spotlight\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/video/redpacket\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/!/(?:search/finder_nav_polling|sug/list/finderchange|was/finder/searchbarchange)\? - reject-dict'
    - '^https://m?api\.weibo\.c(n|om)/2/video/tiny_video_info_show\? - reject-dict'
    - '^https://(?:bootrealtime|bootpreload)\.uve\.weibo\.com/v\d/ad/(?:realtime|preload) - reject-dict'
    - '^https://sdkapp\.uve\.weibo\.com/interface/sdk/(?:get-lbs-cell-info\.php|sdkconfig\.php) - reject-dict'
    - '^https://card\.weibo\.com/article/m/aj/(?:reward|uvead) - reject-dict'
    - '^https://weibo\.com/ttarticle/x/m/aj/(?:reward|uvead) - reject-dict'
  body-rewrite:
    - '^https://m?api\.weibo\.c(n|om)/2/cardlist\? response-jq del(.items[] | select(.category == "group"))'
  mitm:
    - '*.weibo.cn'
    - '*.weibo.com'
    - 'weibo.com'
  script:
    - name: 'weibo_ads'
      match: '^https://m?api\.weibo\.c(n|om)/2/groups/allgroups/v2\?'
      type: 'response'
      timeout: 60
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/(?:checkin/show|client/publisher_list|push/active)'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/groups/allgroups/v2\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/(?:cardlist|page)'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/comments/build_comments\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/(?:container/asyn|flowlist|flowpage)'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/friendships/(?:create|destroy)'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/profile/(?:container_timeline|dealatt|me|statuses/tab|userinfo)'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/shproxy/chaohua/discovery/searchactive\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/statuses/(?:comments_expand_child|container_detail_comment)'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/statuses/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline)'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/statuses/(?:extend|show)\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/video/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/!/huati/discovery_home_bottom_channels\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/direct_messages/user_list\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/messageflow/notice\?'
      type: 'response'
    - name: 'WeiBo_ads'
      match: '^https?://m?api\.weibo\.c(n|om)/2/search/(?:finder|container_timeline|container_discover)\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://m?api\.weibo\.cn/2/searchall\?'
      type: 'response'
    - name: 'weibo'
      match: '^https://bootpreload\.uve\.weibo\.com/v[12]/ad/preload'
      type: 'response'
    - name: 'weibo'
      match: '^https://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php'
      type: 'response'
    - name: 'weibo'
      match: '^https://wbapp\.uve\.weibo\.com/(?:preload/get_ad|wbapplua/wbpullad\.lua)'
      type: 'response'
    - name: 'weibo'
      match: '^https://new\.vip\.weibo\.cn/aj/appicon/list\?'
      type: 'response'
rules:
  - 'DOMAIN-SUFFIX, alitui.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, beacon.sina.com.cn, REJECT'
  - 'DOMAIN-SUFFIX, biz.weibo.com, REJECT'
  - 'DOMAIN, dns.weibo.cn, REJECT'
  - 'DOMAIN, huodong.weibo.cn, REJECT'
  - 'DOMAIN, sax.sina.com.cn, REJECT'
  - 'DOMAIN, saxn.sina.com.cn, REJECT'
  - 'DOMAIN, saxs.sina.com.cn, REJECT'
  - 'DOMAIN, u1.img.mobile.sina.cn, REJECT'
  - 'DOMAIN, bootpreload.uve.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, fastimage.uve.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, adimg.vue.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, zymo.mps.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, weibomingzi.com, REJECT'
  - 'DOMAIN-SUFFIX, sdkapp.uve.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, promote.biz.weibo.cn, REJECT'
  - 'DOMAIN-SUFFIX, gw5.push.mcp.weibo.cn, REJECT'
  - 'DOMAIN-SUFFIX, gw6.push.mcp.weibo.cn, REJECT'
  - 'DOMAIN-SUFFIX, game.weibo.cn, REJECT'
  - 'DOMAIN-SUFFIX, adimg.uve.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, game.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, ads.viber.com, REJECT'
  - 'DOMAIN-SUFFIX, ads-d.viber.com, REJECT'
  - 'DOMAIN-SUFFIX, ads.aws.viber.com, REJECT'
  - 'DOMAIN-SUFFIX, dp.im.weibo.cn, REJECT'
  - 'DOMAIN-SUFFIX, click.uve.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, wax.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, wbapp.uve.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, widget.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, dsp.edm.weibo.cn, REJECT'
  - 'DOMAIN-SUFFIX, alitui.weibo.com.cn, REJECT'
  - 'DOMAIN-SUFFIX, tui.weibo.com, REJECT'
  - 'DOMAIN-SUFFIX, wax.weibo.com.cn, REJECT'
  - 'DOMAIN-SUFFIX, ad.weibo.com, REJECT'
  - 'DOMAIN, datacollection.uve.weibo.com, REJECT'
  - 'DOMAIN, adpinpai.video.weibocdn.com, REJECT'
script-providers:
  weibo_ads:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/weibo_ads.js'
    interval: 86400
  weibo:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/weibo.js'
    interval: 86400
  WeiBo_ads:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/WeiBo.ads.js'
    interval: 86400
