name: 'NodeSeek & DeepFlood'
desc: 'NodeSeek、DeepFlood 每日签到，可设奖励模式。'
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/nodeseek.png
date: '2026-10-02 12:00'
category: '定时任务'
# 由 Loon 插件自动转换：NodeSeek.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：sooyaaabo[https://github.com/sooyaaabo]
arguments-version: 1
arguments:
  Cookie_NodeSeek:
    type: switch
    title: '[NodeSeek]每日签到Cookie'
    default: true
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Task_NodeSeek:
    type: switch
    title: '[NodeSeek]每日签到Task'
    default: true
    description: 开关：开启后执行对应自动任务；关闭则不再执行，不影响已保存的 Cookie。
  Cron_NodeSeek:
    type: input
    title: '[NodeSeek]定时参数Cron'
    default: "0 0 1 * * *"
    description: cron 表达式，默认「0 0 1 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  Mode_NodeSeek:
    type: select
    title: '[NodeSeek]奖励模式Mode'
    default: "default"
    description: 不同选项行为不同，出现异常先改回默认值。
    options:
      - value: 'default'
      - value: 'random'
  Cookie_DeepFlood:
    type: switch
    title: '[DeepFlood]每日签到Cookie'
    default: true
    description: 开关：开启后抓取并保存 Cookie；关闭则不再更新，仍使用已保存的值。Cookie 失效时相关功能会失败。
  Task_DeepFlood:
    type: switch
    title: '[DeepFlood]每日签到Task'
    default: true
    description: 开关：开启后执行对应自动任务；关闭则不再执行，不影响已保存的 Cookie。
  Cron_DeepFlood:
    type: input
    title: '[DeepFlood]定时参数Cron'
    default: "0 0 1 * * *"
    description: cron 表达式，默认「0 0 1 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  Mode_DeepFlood:
    type: select
    title: '[DeepFlood]奖励模式Mode'
    default: "default"
    description: 不同选项行为不同，出现异常先改回默认值。
    options:
      - value: 'default'
      - value: 'random'
http:
  mitm:
    - 'www.nodeseek.com'
    - 'www.deepflood.com'
  script:
    - name: 'NodeSeek_checkin'
      match: '^https://www\.nodeseek\.com/api/account/getInfo/\d+\?readme=1$'
      type: 'request'
    - name: 'DeepFlood_checkin'
      match: '^https://www\.deepflood\.com/api/account/getInfo/\d+\?readme=1$'
      type: 'request'
rules:
  - 'DOMAIN-SUFFIX,nodeseek.com,PROXY'
  - 'DOMAIN-SUFFIX,deepflood.com,PROXY'
cron:
  script:
    - name: 'NodeSeek_checkin'
      cron: '0 9 * * *'
      timeout: 60
    - name: 'DeepFlood_checkin'
      cron: '0 9 * * *'
      timeout: 60
script-providers:
  NodeSeek_checkin:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/NodeSeek.checkin.js'
    interval: 86400
  DeepFlood_checkin:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/DeepFlood.checkin.js'
    interval: 86400
