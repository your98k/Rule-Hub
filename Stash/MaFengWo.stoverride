name: '马蜂窝 去广告'
desc: |-
  移除马蜂窝首页信息流广告、商城横幅推广与「我的」页弹窗。
  Loon 插件原生适配为 Stash 声明式 url-rewrite + body-rewrite，不依赖任何远程脚本。
  来源：loonlab 插件仓库 MaFengWo.lpx（上游 可莉）。
openUrl: 'https://apps.apple.com/app/id391066926'
author: '可莉 · Loon→Stash 原生适配'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/MaFengWo.png'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

rules:
  - 'DOMAIN,advert.mafengwo.cn,REJECT'

http:
  mitm:
    - 'mapi.mafengwo.cn'
  url-rewrite:
    - '^https://mapi\.mafengwo\.cn/user/growth/get_growth_tip/v1\? reject-dict'
  body-rewrite:
    - '^https://mapi\.mafengwo\.cn/discovery/get_index/v7\? response-jq .data.list |= map(select(.data.business_type != "gdcpm"))'
    - '^https://mapi\.mafengwo\.cn/sales/home/get_header/v3\? response-jq .data.list[] |= ( .data |= del(.banners) )'
