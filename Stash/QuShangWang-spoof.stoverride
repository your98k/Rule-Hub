name: '去上网 伪造测试（临时）'
desc: |-
  实验：用脚本把自有接口响应替换为空 data，验证开屏广告能否跳过
  若 App 闪退属预期风险，关掉本覆写即可恢复
category: '去广告'
openUrl: 'https://apps.apple.com/cn/app/id1215148253'
date: '2026-11-16 20:15'
version: '4.1-spoof'

arguments-version: 1
arguments:
  spoof_mode:
    type: select
    title: 伪造范围
    default: range
    options:
      - value: range
        label: 仅 400-600 字节响应（实测开屏为 443，最精准）
      - value: small
        label: 所有小于 600 字节响应（较激进）
      - value: all
        label: 全部接口返回空 data（验证容忍度）
  ad_action:
    type: select
    title: 第三方广告域名
    default: REJECT
    options:
      - value: REJECT
        label: 拦截（正式使用）
      - value: DIRECT
        label: 放行（仅验证伪造响应时选，可排除干扰）

http:
  force-http-engine:
    - 'qudaapi.8quan.com:80'
  mitm:
    - '*.8quan.com'
    - '*.yedone.com'
  script:
    - name: qd-spoof
      match: '^http://qudaapi\.8quan\.com/index\.php'
      type: response
      require-body: true
      max-size: 2097152
      timeout: 8
      engine: auto
      argument: '{"mode":${args.spoof_mode|json}}'

script-providers:
  qd-spoof:
    payload: |
      var cfg = {};
      try { cfg = JSON.parse($argument || '{}'); } catch (e) { cfg = {}; }
      var mode = cfg.mode || 'small';
      var body = String(($response && $response.body) || '');
      var len = body.length;
      $persistentStore.write('hit mode=' + mode + ' len=' + len, 'qd_spoof_log');
      var shouldSpoof = (mode === 'all')
        || (mode === 'small' && len < 600)
        || (mode === 'range' && len >= 400 && len <= 600);
      if (shouldSpoof) {
        var empty = '{"time_stamp":1794825375,"p_encrypt":"","data":"","res":0,"msg":"操作成功"}';
        $done({ body: empty });
      } else {
        $done({});
      }

rules:
  - 'DOMAIN-SUFFIX,shanghailingye.cn,${args.ad_action}'
  - 'DOMAIN-SUFFIX,hzzfcm.com,${args.ad_action}'
