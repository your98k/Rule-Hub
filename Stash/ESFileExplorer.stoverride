name: 'ES文件浏览器 解锁会员'
desc: |-
  ES 文件浏览器(iOS)解锁 VIP:会员标记、到期时间与服务端下发的会员类型,让客户端已解锁的特权可用。
  只改写 App 与 ES 服务端之间的会员状态响应,不动 Apple 真实订阅;其它 App、非 JSON、结构不符时原样放行。
  QUIC 说明:Stash 不支持对 QUIC 流量做改写,ES 若走 HTTP/3 则会员状态脚本不生效;
  需要时先在 App 或分流里关掉 QUIC,让流量回落 HTTP/2。
  自定义参数仅支持 Stash 3.7 及以上版本。
category: '会员解锁'
icon: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/assets/icons/ESFileExplorer.png'
openUrl: 'https://apps.apple.com/app/id1441621965'
date: '2026-11-22'
version: '1.0.1'
author: 'your98k'
homepage: 'https://github.com/your98k/Rule-Hub'

arguments-version: 1
arguments:
  enable:
    type: switch
    title: 启用会员注入
    description: 关闭后本覆写完全放行,用于快速回退。
    default: true
  days:
    type: input
    value-type: integer
    title: 会员有效天数
    description: 到期时间每次请求按当前时间重算,不会因为写死而过期。
    default: 3650
    minimum: 1
    maximum: 36500
  vip_type:
    type: input
    title: 会员类型值
    description: 写入 vip_type / vipType 的值。ES 用字符串标识套餐等级,抓到真实值后按需改。
    default: '1'
    max-length: 32
  debug:
    type: switch
    title: 输出调试日志
    description: 打开后在 Stash 日志里搜 [es] 查看命中与改写详情。
    default: false

http:
  mitm:
    - 'iects.doglobal.net'
    - 'esfile.doglobal.net'
    - 'api.duapps.com'
    - 'dvc.doglobal.net'
    - 'api-es.doglobal.net'
  script:
    - name: es-vip-request
      match: '^https?://(?:iects|esfile)\.doglobal\.net/|^https?://(?:api|dvc)\.duapps\.com/|^https?://dvc\.doglobal\.net/|^https?://api-es\.doglobal\.net/'
      type: request
      require-body: false
      timeout: 10
      argument: '{"debug":${args.debug|json}}'
    - name: es-vip-response
      match: '^https?://(?:iects|esfile)\.doglobal\.net/|^https?://(?:api|dvc)\.duapps\.com/|^https?://dvc\.doglobal\.net/|^https?://api-es\.doglobal\.net/'
      type: response
      require-body: true
      timeout: 15
      max-size: 1048576
      binary-mode: false
      argument: '{"enable":${args.enable|json},"days":${args.days|json},"vip_type":${args.vip_type|json},"debug":${args.debug|json}}'

script-providers:
  es-vip-request:
    payload: |-
      /**
       * ES 文件浏览器 · 请求侧解除条件缓存(Stash 版,署名 your98k)
       *
       * 服务端一旦按 ETag / Last-Modified 回 304,响应侧脚本拿不到任何 body,
       * 会员字段就永远改不了。这里把条件缓存头去掉,强制拿完整 200 响应。
       * 只动缓存协商相关头,不改 Cookie / Token / 签名。
       */
      (function () {
        var H = $request.headers || {};
        var drop = ['if-none-match', 'if-modified-since', 'If-None-Match', 'If-Modified-Since'];
        var hit = [];
        for (var i = 0; i < drop.length; i++) {
          if (Object.prototype.hasOwnProperty.call(H, drop[i])) {
            delete H[drop[i]];
            hit.push(drop[i]);
          }
        }
        var dbg = false;
        try { dbg = !!(JSON.parse($argument || '{}').debug); } catch (e) {}
        if (dbg && hit.length) console.log('[es] req drop-cache: ' + hit.join(','));
        $done({ headers: H });
      })();
  es-vip-response:
    payload: |-
      /**
       * ES 文件浏览器 · 会员状态注入(Stash 版,署名 your98k)
       *
       * 为什么按结构而不按固定键名:
       * 客户端会员模型是 ESPublicDataModel,字段 isVip / isRenewVip / vipType /
       * vipTrailEndDate;服务端同一含义的 JSON 出现过 vip_type / expire_time /
       * expiredTime / expireDays 等多种命名。写死一个键名,换个账号或版本就整包放行,
       * 表现为「有人生效有人不生效」。所以这里按特征键打分找节点,找不到就不动。
       *
       * 三条硬纪律:
       * 1. 到期时间每次按 now + N 天重算,不写死,避免一年后静默失效。
       * 2. 结构不符 / 非 JSON / 开关关闭 → 原样放行,绝不让内购页报错。
       * 3. 只改已有节点的值,不凭空重建整个响应结构。
       */
      (function () {
        var opt = {};
        try { opt = JSON.parse($argument || '{}') || {}; } catch (e) { opt = {}; }

        var DBG = !!opt.debug;
        function log() {
          if (!DBG) return;
          var a = Array.prototype.slice.call(arguments);
          console.log('[es] ' + a.join(' '));
        }

        if (opt.enable === false) { log('skip: disabled'); $done({}); return; }

        var days = parseInt(opt.days, 10);
        if (!isFinite(days) || days <= 0) days = 3650;
        var vipType = (opt.vip_type == null ? '1' : String(opt.vip_type));

        var body = $response && $response.body;
        if (!body || typeof body !== 'string') { log('skip: empty body'); $done({}); return; }

        var head = body.replace(/^\uFEFF/, '').replace(/^\s+/, '').charAt(0);
        if (head !== '{' && head !== '[') { log('skip: not json'); $done({}); return; }

        var root;
        try { root = JSON.parse(body); } catch (e) { log('skip: parse error'); $done({}); return; }
        if (!root || typeof root !== 'object') { log('skip: not object'); $done({}); return; }

        var expiry = Math.floor(Date.now() / 1000) + days * 86400;

        // 特征键:布尔型
        var BOOL_KEYS = ['isVip', 'is_vip', 'isVIP', 'isVipUser', 'isMember', 'is_member',
          'isSvip', 'is_svip', 'hasVip', 'has_vip', 'vipValid', 'vip_valid', 'isVipFunction'];
        // 特征键:类型/等级
        var TYPE_KEYS = ['vip_type', 'vipType', 'vipGrade', 'vip_grade', 'vipLevel', 'vip_level',
          'memberType', 'member_type'];
        // 特征键:到期时间(秒级时间戳)
        var TIME_KEYS = ['vipTrailEndDate', 'vipEndTime', 'vip_end_time', 'vipExpireTime',
          'vip_expire_time', 'expire_time', 'expireTime', 'expiredTime', 'expireTimestamp',
          'endTime', 'end_time'];
        // 特征键:剩余天数
        var DAY_KEYS = ['expireDays', 'vipExpireDays', 'remainDays', 'vipRemainDays'];

        function has(obj, keys) {
          var out = [];
          for (var i = 0; i < keys.length; i++) {
            if (Object.prototype.hasOwnProperty.call(obj, keys[i])) out.push(keys[i]);
          }
          return out;
        }

        // 一个对象要同时具备「开通标记」+「等级或有效期」才算会员节点,避免误伤
        // 网盘侧同名 vip 字段(ES 内嵌百度网盘等第三方账号信息也会带 vip 字样)。
        function score(obj, b, t, m, d) {
          var s = b.length;
          if (t.length) s += 1;
          if (m.length || d.length) s += 1;
          return s;
        }

        var touched = 0;
        var seen = [];

        function applyTo(obj, path) {
          if (!obj || typeof obj !== 'object' || Array.isArray(obj)) return false;
          var b = has(obj, BOOL_KEYS);
          var t = has(obj, TYPE_KEYS);
          var m = has(obj, TIME_KEYS);
          var d = has(obj, DAY_KEYS);
          if (score(obj, b, t, m, d) < 2) return false;

          var i;
          for (i = 0; i < b.length; i++) obj[b[i]] = true;
          for (i = 0; i < t.length; i++) obj[t[i]] = vipType;
          for (i = 0; i < m.length; i++) obj[m[i]] = expiry;
          for (i = 0; i < d.length; i++) obj[d[i]] = days;

          seen.push(path + ' {b:' + b.join('/') + (t.length ? ' t:' + t.join('/') : '')
            + (m.length ? ' m:' + m.join('/') : '') + (d.length ? ' d:' + d.join('/') : '') + '}');
          return true;
        }

        // 会员节点可能被二次编码成字符串,解析后必须写回同一个键(写成对象会让客户端读不到)。
        function expandString(obj, path) {
          if (!obj || typeof obj !== 'object' || Array.isArray(obj)) return;
          for (var k in obj) {
            if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;
            var v = obj[k];
            if (typeof v !== 'string') continue;
            var c = v.replace(/^\s+/, '').charAt(0);
            if (c !== '{' && c !== '[') continue;
            if (v.length > 262144) continue;
            try {
              var inner = JSON.parse(v);
              if (inner && typeof inner === 'object') {
                applyTo(inner, path + '.' + k);
                walk(inner, path + '.' + k, 0);
                obj[k] = JSON.stringify(inner);
              }
            } catch (e) {}
          }
        }

        function walk(node, path, depth) {
          if (!node || typeof node !== 'object' || depth > 12) return;
          if (Array.isArray(node)) {
            for (var i = 0; i < node.length && i < 200; i++) walk(node[i], path + '[' + i + ']', depth + 1);
            return;
          }
          if (applyTo(node, path)) touched++;
          var keys = Object.keys(node);
          for (var j = 0; j < keys.length && j < 200; j++) {
            var k = keys[j];
            var v = node[k];
            if (v && typeof v === 'object') walk(v, path + '.' + k, depth + 1);
          }
          expandString(node, path);
        }

        walk(root, '$', 0);

        // 关键补建路径:免费账号拉会员状态时,服务端可能压根不下发任何会员字段。
        // 只在这种响应上按最小结构补建,否则整包放行 —— 这就是「别人生效我不生效」的根因。
        // 补建只加 3 个客户端模型里最确定的键,不加整个会员对象,避免客户端解析出陌生结构。
        if (!touched) {
          var url = ($request && $request.url) ? $request.url.split('?')[0] : '';
          var looksVip = /(?:^|[/_\-.])(vip|member|sku|account|profile|user|order|pay)(?:[/_\-.$]|$)/i.test(url);
          if (looksVip && !Array.isArray(root)) {
            var host = (root.data && typeof root.data === 'object' && !Array.isArray(root.data)) ? root.data : root;
            host.isVip = true;
            host.vip_type = vipType;
            host.vipTrailEndDate = expiry;
            touched = 1;
            log('create: no vip node, built isVip/vip_type/vipTrailEndDate at '
              + (host === root ? '$' : '$.data'));
          } else {
            log('skip: no vip node in ' + url);
            $done({});
            return;
          }
        }

        log('ok: nodes=' + touched + ' exp=' + expiry + ' type=' + vipType);
        if (DBG) log('hit: ' + seen.join(' | '));

        var text;
        try { text = JSON.stringify(root); } catch (e) { log('skip: stringify error'); $done({}); return; }

        var headers = $response.headers || {};
        delete headers['Content-Length'];
        delete headers['content-length'];
        delete headers['Content-Encoding'];
        delete headers['content-encoding'];
        delete headers['Transfer-Encoding'];
        delete headers['transfer-encoding'];
        delete headers['ETag'];
        delete headers['etag'];

        $done({ body: text, headers: headers });
      })();