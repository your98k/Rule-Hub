name: 'AppStore Monitor'
desc: 'App Store 更新监控，按 AppID 查询并推送通知。'
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/AppStore.png
date: '2026-10-02 12:00'
category: '功能增强, 定时任务'
# 由 Loon 插件自动转换：AppStoreMonitor.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：sooyaaabo[https://github.com/sooyaaabo]
arguments-version: 1
arguments:
  RunCron:
    type: input
    title: '监控定时参数'
    default: "0 9 * * *"
    description: cron 表达式，默认「0 9 * * *」。格式写错会导致任务不执行，且通常没有任何报错。
  app_ids:
    type: input
    title: 'AppStore AppID'
    default: ""
    description: 多个 AppID 用逗号分隔。留空则该任务不会查询任何 App。
  regions:
    type: input
    title: 'AppStore Region'
    default: ""
    description: 按插件说明填写；填错通常表现为该功能不生效。
  bark_key:
    type: input
    title: 'Bark Key'
    default: ""
    description: 接口令牌，留空则走公共接口。公共接口有限速，可能失败或返回不全。
  bark_group:
    type: input
    title: 'Bark Group'
    default: ""
    description: 推送分组名，留空表示不分组。填错只影响通知归类，不影响功能。
  bark_sound:
    type: select
    title: 'Bark Sound'
    default: "system"
    description: 不同选项行为不同，出现异常先改回默认值。
    options:
      - value: 'system'
      - value: 'alarm'
      - value: 'anticipate'
      - value: 'bell'
      - value: 'birdsong'
      - value: 'bloom'
      - value: 'calypso'
      - value: 'chime'
      - value: 'choo'
      - value: 'descent'
      - value: 'electronic'
      - value: 'fanfare'
      - value: 'glass'
      - value: 'gotosleep'
      - value: 'healthnotification'
      - value: 'horn'
      - value: 'ladder'
      - value: 'mailsent'
      - value: 'minuet'
      - value: 'multiwayinvitation'
      - value: 'newmail'
      - value: 'newsflash'
      - value: 'noir'
      - value: 'paymentsuccess'
      - value: 'shake'
      - value: 'sherwoodforest'
      - value: 'silence'
      - value: 'spell'
      - value: 'suspense'
      - value: 'telegraph'
      - value: 'tiptoes'
      - value: 'typewriters'
      - value: 'update'
cron:
  script:
    - name: 'AppStoreMonitor'
      cron: '${args.RunCron}'
      timeout: 60
script-providers:
  AppStoreMonitor:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/AppStoreMonitor.js'
    interval: 86400
