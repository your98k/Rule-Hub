name: 'AppStore Monitor'
desc: 'App Store 更新监控，按 AppID 查询并推送通知。'
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/AppStore-02.png'
date: '2026-10-02 12:00'
category: '功能增强, 定时任务'
# 由 Loon 插件自动转换：AppStoreMonitor.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：sooyaaabo[https://github.com/sooyaaabo]
arguments-version: 1
arguments:
  RunCron:
    type: input
    title: '监控定时参数'
    default: "0 9 * * *"
  app_ids:
    type: input
    title: 'AppStore AppID'
    default: ""
  regions:
    type: input
    title: 'AppStore Region'
    default: ""
  bark_key:
    type: input
    title: 'Bark Key'
    default: ""
  bark_group:
    type: input
    title: 'Bark Group'
    default: ""
  bark_sound:
    type: select
    title: 'Bark Sound'
    default: "system"
    options:
      - value: 'system'
      - value: 'alarm'
      - value: 'anticipate'
      - value: 'bell'
      - value: 'birdsong'
      - value: 'bloom'
      - value: 'calypso'
      - value: 'chime'
      - value: 'choo'
      - value: 'descent'
      - value: 'electronic'
      - value: 'fanfare'
      - value: 'glass'
      - value: 'gotosleep'
      - value: 'healthnotification'
      - value: 'horn'
      - value: 'ladder'
      - value: 'mailsent'
      - value: 'minuet'
      - value: 'multiwayinvitation'
      - value: 'newmail'
      - value: 'newsflash'
      - value: 'noir'
      - value: 'paymentsuccess'
      - value: 'shake'
      - value: 'sherwoodforest'
      - value: 'silence'
      - value: 'spell'
      - value: 'suspense'
      - value: 'telegraph'
      - value: 'tiptoes'
      - value: 'typewriters'
      - value: 'update'
cron:
  script:
    - name: 'AppStoreMonitor'
      cron: '${args.RunCron}'
      timeout: 60
script-providers:
  AppStoreMonitor:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/AppStoreMonitor.js'
    interval: 86400
