name: '快手 去广告'
desc: |-
  移植 loonlab 插件仓库 Kwai.lpx：4 条 url-rewrite、6 条 body-rewrite。
  json.jq / json.delete 映射为 response-jq，reject_dict 映射为 reject-dict。
  覆盖 7 个域名，使用前请在 Stash 信任 MitM CA。
  来源：loonlab 插件仓库 Kwai.lpx。
openUrl: 'https://apps.apple.com/app/id436507552'
author: 'loonlab · Loon→Stash 原生适配'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

http:
  mitm:
    - 'az*-api.ksapisrv.com'
    - 'az4-api-idc.ksapisrv.com'
    - 'az*-api-idc.ksapisrv.com'
    - 'apissl.gifshow.com'
    - 'apissl.ksapisrv.com'
    - 'az*-api-js.gifshow.com'
    - 'az*-live.ksapisrv.com'
  url-rewrite:
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/nearby/widget/info\? - reject-dict'
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/taskCenter/task/report\? - reject-dict'
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/ad/ - reject-dict'
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/live/feed/info/simplelive/card\? - reject-dict'
  body-rewrite:
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/system/startup\? response-jq del(.reskinConfig, .sidebarExSquareStyle.moreList, .sidebarExSquareStyle.topList)'
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/system/startup\? response-jq .sidebarExSquareStyle.commonlyUsedList |= map(select(.title == "设置" or .title == "历史记录" or .title == "草稿箱" or .title == "我的钱包" or .title == "小程序" or .title == "未成年人模式" or .title == "官方客服" or .title == "内容偏好" or .title == "离线模式" or .title == "稍后再看" or .title == "举报中心" or .title == "挂件"))'
    - '^https://(apissl|az\d-live|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/live/feed/square/refresh\? response-jq del(.data.banners)'
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/feed/(selection|selectionFast)\? response-jq if (.feeds | type) == "array" then .feeds |= map(select(.ad | not)) else . end'
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/user/profile/v2\? response-jq del(.postRecommends)'
    - '^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/im/wd/top/navigation/getRecommendedSession\? response-jq del(.data.operationRecommendationList)'
