name: 'Google CN 域名跳转'
desc: 'Google CN 域名跳转，共 3 条规则。'
openUrl: 'https://www.google.com'
author: 'your98k'
icon: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/google.png
category: '功能增强'
date: '2026-11-15'
version: '1.0.0'

http:
  mitm:
    - '*.google.cn'
    - '*.g.cn'
  url-rewrite:
    - '^https?://(www\.)?(?:g|google)\.cn https://www.google.com 307'
    - '^https?://(?:ditu|maps)\.google\.cn https://maps.google.com 307'
    - '^https?://translate\.google\.cn https://translate.google.com 307'
