name: usAge Pro
desc: 把 usAge 账号权益接口返回的 entitlements.pro.active 置为有效（/api/v1/me、/api/v1/auth/apple、/api/v1/me/entitlements）

http:
  mitm:
    - 'usage.o-c.do'
  script:
    - name: usage-pro
      match: '^https:\/\/usage\.o-c\.do\/api\/v1\/(me(\/entitlements)?|auth\/apple)($|\?)'
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: false
      engine: auto

script-providers:
  usage-pro:
    url: 'https://api.pastes.dev/4Q0mPDXj39'
    interval: 86400
