      'match': '^h[${args.master_enabled|json}][${args.live_ad|json}${args.live_callbacks|json}${args.live_preload_tracking|json}${args.privacy_tracking|json}]ps?://api\.live\.bilibili\.com/xlive/(?:app-interface/v2/(?:index/feed|room/recList)|app-room/v1/index/getInfoByRoom)(?:\?|$)'
      'timeout': 10
      'engine': '${args.script_engine}'
      'argument': '{"master_enabled":${args.master_enabled|json},"live_ad":${args.live_ad|json},"live_callbacks":${args.live_callbacks|json},"live_preload_tracking":${args.live_preload_tracking|json},"privacy_tracking":${args.privacy_tracking|json},"feed_block_uids":${args.feed_block_uids|json},"log_level":${args.log_level|json}}'
      'require-body': true
      'max-size': '${args.json_max_size}'
    - 'name': 'rulehub.bilibili.enhanced.json'
      'type': 'response'
      'match': '^h[${args.master_enabled|json}][${args.pgc_ad|json}]ps?://(?:api\.bilibili\.com|api\.biliapi\.net|api\.biliapi\.com)/pgc/page/(?:bangumi|cinema/tab|channel)(?:\?|$)'
      'timeout': 10
      'engine': '${args.script_engine}'
      'argument': '{"master_enabled":${args.master_enabled|json},"pgc_ad":${args.pgc_ad|json},"feed_block_uids":${args.feed_block_uids|json},"log_level":${args.log_level|json}}'
      'require-body': true
      'max-size': '${args.json_max_size}'
    - 'name': 'rulehub.bilibili.enhanced.json'
      'type': 'response'
      'match': '^h[${args.master_enabled|json}][${args.p2p_block|json}]ps?://(?:api\.live\.bilibili\.com/xlive/open-interface/v2/tracker/conf|api\.bilibili\.com/x/pd-proxy/tracker)(?:\?|$)'
      'timeout': 10
      'engine': '${args.script_engine}'
      'argument': '{"master_enabled":${args.master_enabled|json},"p2p_block":${args.p2p_block|json},"feed_block_uids":${args.feed_block_uids|json},"log_level":${args.log_level|json}}'
      'require-body': true
      'max-size': '${args.json_max_size}'
    - 'name': 'rulehub.bilibili.enhanced.json'
      'type': 'response'
      'match': '^h[${args.master_enabled|json}][${args.pgc_player_tips|json}]ps?://(?:api\.bilibili\.com|api\.biliapi\.net|api\.biliapi\.com)/pgc/view/v2/app/season(?:\?|$)'
      'timeout': 10
      'engine': '${args.script_engine}'
      'argument': '{"master_enabled":${args.master_enabled|json},"pgc_player_tips":${args.pgc_player_tips|json},"feed_block_uids":${args.feed_block_uids|json},"log_level":${args.log_level|json}}'
      'require-body': true
      'max-size': '${args.json_max_size}'
    - 'name': 'bilibili.json'
      'type': 'response'
      'match': '^h[${args.master_enabled|json}][${args.navigation_clean|json}]ps?://(?:app\.bilibili\.com|app\.biliapi\.net|app\.biliapi\.com)/x/resource/show/tab/v2(?:\?|$)'
      'timeout': 10
      'engine': '${args.script_engine}'
      'argument': '{"showCreatorHub":false,"logLevel":${args.log_level|json}}'
      'require-body': true
      'max-size': '${args.json_max_size}'
    - 'name': 'bilibili.json'
