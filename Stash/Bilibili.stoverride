      'match': '^h[${args.master_enabled|json}][${args.mine_clean|json}]ps?://(?:app\.bilibili\.com|app\.biliapi\.net|app\.biliapi\.com)/x/v2/account/(?:mine(?:/ipad)?|myinfo)(?:\?|$)'
      'timeout': 10
