#Rule-Hub Bilibili v1.1.5 本地轻量增强。原文件：https://raw.githubusercontent.com/your98k/Rule-Hub/main/Stash/Bilibili.stoverride
#新增脚本原创 GPL-3.0-or-later；协议布局核对自 Rule-Hub/Sparkle 与 Biliverse。
#替换旧覆写使用，不与旧版叠加。没有删除原配置数组，按Stash默认递归合并/数组前插。

'name': '哔哩哔哩去广告 · Rule-Hub 横幅增强版'
'desc': '以 your98k/Rule-Hub Bilibili v1.1.5 为底座的本地增强文件，非上游官方版本。

  保留原导航/我的页/网页与空降实现，新增截图中的动态/个人动态流/播放页/交互弹幕/彩色弹幕开关，另补齐首页、直播、隐私与独立横幅控制。

  重点：旧版播放页 cm_under_player(48)、广告 Tab，及新版简介页活动/会员/BANNER 模块、cm(7)、播放器 prompt_bar、番剧提示横幅；全部使用已核对字段。新版未知48字段保留，不盲删。

  小型 wire-level 脚本只改指定字段，不展开整份 protobuf 对象，不叠加前版约1MB业务脚本。无变化直接放行，未知字段及正常视频保留。

  需要 Stash iOS/tvOS 3.7+ 或 macOS 4.4+。导入后在覆写详情 → 参数设置。停用原 Rule-Hub 及其他重叠 B站覆写，不要同时启用。

  需启用 MitM 并信任自己的 CA。总开关只控制此覆写 HTTP 改写，原 QUIC/备用API/P2P 规则及 MitM 主机保留；彻底退出请关闭整份覆写。

  默认自动引擎，不强制未经实机验证的 JSC。gRPC 输入512KB、解压1MB、JSON1MB上限，超限原样放行，过大接口可能无法去广告。

  空降沿用原作者请求重放及 Chronos 方案，会查询 bsbsb.top/下载原作者资源；不保证当前客户端兼容。关闭空降后不再重放弹幕请求。

  我的页/底部导航净化沿用原作者全部行为（可能包含本地展示修改，不代表会员或服务端权限）；可以单独关闭。

  保留原规则中的备用API域名拒绝，可能触发客户端回退；原全局端口拒绝改为仅B站视频域名以免影响其他服务。

  已做 YAML/脚本模拟校验，未在真实 Stash/B站当前客户端中实测。此文件不会自动更新到原仓库，远程作者脚本仍按其地址更新。

  新增处理代码 GPL-3.0-or-later，gzip 解码器 pako 为 MIT/zlib；完整许可与可维护源码见仓库 Script/Bilibili_enhanced.* 与 LICENSE 文件。'
'version': '1.1.5-enhanced.1'
'author': 'kokoryh[https://github.com/kokoryh], Biliverse[https://github.com/Biliverse]'
'homepage': 'https://github.com/kokoryh/Sparkle'
'openUrl': 'https://apps.apple.com/app/id736536022'
'icon': 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png'
'category': 'ad'
'arguments-version': 1
'arguments':
  'master_enabled':
    'type': 'switch'
    'title': '[总开关] 启用 HTTP 净化'
    'description': '控制所有本文件新增及原有 HTTP 拦截；网络分流规则和 MitM 域名仍保留。'
    'default': true
  'view_banner':
    'type': 'switch'
    'title': '[视频] 去除播放页横幅广告'
    'description': '独立控制旧版播放器下方横幅(cm_under_player)、新版活动/会员/BANNER模块、cm广告栏、播放器prompt_bar及番剧试看提示栏。与下方播放页卡片去广告独立。'
    'default': true
  'splash_ad':
    'type': 'switch'
    'title': '[开屏] 去除广告'
    'description': '是否启用此处修改'
    'default': true
  'feed_ad':
    'type': 'switch'
    'title': '[推荐] 去除广告'
    'description': '按已确认广告标志过滤推荐卡片，保留普通视频和正常直播；与活动大图/竖屏/名单分别控制。'
    'default': true
  'feed_activity':
    'type': 'switch'
    'title': '[推荐] 去除“活动大图”'
    'description': '过滤首页推荐活动大图；轻量版不改写推荐请求签名，不请求新视频补位。'
    'default': false
  'feed_vertical':
    'type': 'switch'
    'title': '[推荐] 去除竖屏视频'
    'description': '过滤首页竖屏视频，不额外请求补位；与首页广告主开关独立。'
    'default': false
  'feed_block_uids':
    'type': 'input'
    'title': '[推荐] 屏蔽UP主直播推广'
    'description': '逗号、中文逗号、分号或空格分隔UP主UID；只控制推荐中的直播推广，需开启“启用UP主直播名单”，不依赖首页去广告。'
    'default': ''
    'max-length': 4096
  'story_ad':
    'type': 'switch'
    'title': '[首页] 去除短视频流广告'
    'description': '是否启用此处修改'
    'default': true
  'story_commercial':
    'type': 'switch'
    'title': '[首页] 去除Story商业按钮'
    'description': '移除Story中的“助TA必火”等商业推广按钮，不删除视频卡片。'
    'default': true
  'search_ad':
    'type': 'switch'
    'title': '[搜索] 去除广告'
    'description': '是否启用此处修改'
    'default': true
  'search_hot':
    'type': 'switch'
    'title': '[搜索] 去除“热搜”'
    'description': '是否启用此处修改'
    'default': true
  'pgc_ad':
    'type': 'switch'
    'title': '[番剧电影] 去除广告'
    'description': '是否启用此处修改'
    'default': true
  'live_ad':
    'type': 'switch'
    'title': '[直播] 去除广告'
    'description': '是否启用此处修改'
    'default': true
  'live_callbacks':
    'type': 'switch'
    'title': '[直播] 移除推荐回调'
    'description': '移除直播推荐卡的show_callback与click_callback；可能影响推荐状态和翻页。'
    'default': false
  'live_preload_tracking':
    'type': 'switch'
    'title': '[直播] 移除预载链接trackid'
    'description': '只移除直播small_card_v1.subtitle_style.link中的trackid，保留播放、清晰度和会话参数。'
    'default': false
  'dynamic_topics':
    'type': 'switch'
    'title': '[动态] 去除“热门话题”'
    'description': '同时控制旧版话题接口和新版 gRPC 动态热门话题。'
    'default': true
  'dynamic_most_visited':
    'type': 'switch'
    'title': '[动态] 去除“最常访问”'
    'description': '同时控制旧版接口和新版 gRPC 的最常访问区域；开启时优先于“仅显示直播”。'
    'default': false
  'dynamic_live_only':
    'type': 'switch'
    'title': '[动态] “最常访问”仅显示直播'
    'description': '最常访问仅保留 live_state=1 的UP；“去除最常访问”开启时优先隐藏。'
    'default': false
  'dynamic_ad':
    'type': 'switch'
    'title': '[动态] 去除广告卡片'
    'description': '过滤 DynAll/DynVideo 的 cardType=15 广告，保留其他动态及未知字段，不连带删除转发卡片。'
    'default': true
  'dynamic_personal_ad':
    'type': 'switch'
    'title': '[动态] 去除个人流广告卡片'
    'description': '过滤 DynAllPersonal/DynVideoPersonal 的 cardType=15；仅协议夹具验证，缺少当前客户端广告阳性实机样本。'
    'default': false
  'view_ad':
    'type': 'switch'
    'title': '[视频] 去除播放页广告'
    'description': '清理播放页广告卡片、关联推荐广告及广告视频片段；横幅广告请另看上方独立开关。不会把全部推荐内容清空。'
    'default': true
  'dm_command':
    'type': 'switch'
    'title': '[弹幕] 去除交互式弹幕'
    'description': '只移除 DmView 的交互式弹幕字段，水印与彩色弹幕由独立开关控制。'
    'default': false
  'dm_colorful':
    'type': 'switch'
    'title': '[弹幕] 替换彩色弹幕'
    'description': '只移除会员彩色类型60001标志，不修改普通弹幕文字、时间、RGB颜色与其他类型。'
    'default': false
  'reply_ad':
    'type': 'switch'
    'title': '[评论] 去除广告'
    'description': '是否启用此处修改'
    'default': true
  'privacy_tracking':
    'type': 'switch'
    'title': '[隐私] 移除响应链接跟踪参数'
    'description': '只清理JSON响应跳转链接的已知归因参数及track字段；不扫描未知protobuf字节，不改视频地址/播放签名。'
    'default': true
  'privacy_bili_report':
    'type': 'switch'
    'title': '[隐私] 阻止B站商业上报'
    'description': '本地成功响应conversion/mobile/v2与fees/wise，阻止相关请求上传。'
    'default': false
  'privacy_third_party':
    'type': 'switch'
    'title': '[隐私] 阻止第三方广告归因'
    'description': '本地响应已确认的千问与Solar Engine广告展示、点击和归因请求。'
    'default': false
  'feed_uid_filter':
    'type': 'switch'
    'title': '[推荐] 启用 UP 主直播名单'
    'description': '关闭后保留已填 UID 名单，但不执行名单屏蔽；仍依赖“推荐去广告”。'
    'default': true
  'search_recommend':
    'type': 'switch'
    'title': '[搜索] 去除大家都在搜'
    'description': '控制旧版 recommend_words 接口；与热搜和搜索广告独立。'
    'default': true
  'search_default_words':
    'type': 'switch'
    'title': '[搜索] 去除搜索框默认词'
    'description': '开启时返回 HTTP 200、grpc-status 0 和五字节空 gRPC 帧；关闭则不拦截该请求。'
    'default': true
  'manga_flash':
    'type': 'switch'
    'title': '[漫画] 去除 Flash 广告'
    'description': '仅控制漫画 Flash 接口的空字典响应。'
    'default': true
  'manga_list_flash':
    'type': 'switch'
    'title': '[漫画] 去除 ListFlash 广告'
    'description': '仅控制漫画 ListFlash 接口的空字典响应。'
    'default': true
  'live_shopping':
    'type': 'switch'
    'title': '[直播] 去除购物信息'
    'description': '独立控制购物接口Mock；直播房间已有购物区域也可能受“直播去广告”控制。'
    'default': true
  'view_tfinfo':
    'type': 'switch'
    'title': '[视频] 去除免流办卡推广'
    'description': '独立控制旧版 TFInfo 接口；不再无条件跟随响应脚本执行。'
    'default': true
  'background_play':
    'type': 'switch'
    'title': '[视频] 调整旧版后台播放配置'
    'description': '沿用原作者本地播放配置调整；不表示解锁会员或服务端权限。'
    'default': true
  'pgc_player_tips':
    'type': 'switch'
    'title': '[番剧] 隐藏播放器提示栏'
    'description': '控制番剧 cast_tips 及原作者 payment 展示清理；试看提示横幅由播放页横幅开关独立控制。'
    'default': true
  'teenagers_popup':
    'type': 'switch'
    'title': '[界面] 隐藏青少年模式提醒'
    'description': '仅保留上游 ModeStatus 提醒字段修改；不等于解除已启用的青少年模式或监护设置。'
    'default': true
  'dm_watermark':
    'type': 'switch'
    'title': '[弹幕] 去除雲視聽水印'
    'description': '独立控制 DmView 的 activityMeta 清理，不受交互式弹幕开关影响。'
    'default': true
  'airborne':
    'type': 'switch'
    'title': '空降助手'
    'description': '沿用原作者bsbsb.top与Chronos空降实现，涉及第三方视频标识查询和弹幕请求重放；关闭后不执行该请求脚本，需实际客户端支持。'
    'default': true
  'airborne_policy':
    'type': 'input'
    'title': '空降助手策略'
    'description': '填写你的代理组名，默认 DIRECT 直连'
    'default': 'DIRECT'
    'required': true
    'max-length': 128
  'purify_comment':
    'type': 'switch'
    'title': '过滤置顶评论广告'
    'default': true
    'description': '仅过滤已识别b23.tv/cm或mall等置顶带货链接；不因“淘宝/京东”等普通文字误删整条评论。'
  'popular_ad':
    'type': 'switch'
    'title': '[热门] 过滤广告推广卡片'
    'description': '保留原热门页推广卡片过滤，未知类型原样保留。'
    'default': true
  'view_modules':
    'type': 'switch'
    'title': '[视频] 隐藏附加推广模块'
    'description': '沿用原作者特殊标签/视频提及模块清理；普通简介和目录不会删除。'
    'default': true
  'remove_charge_button':
    'type': 'switch'
    'title': '[视频] 隐藏充电增强入口'
    'description': '仅沿用原作者 elec_plus_btn 清理，不修改用户余额或服务端功能。'
    'default': true
  'cast_enabled':
    'type': 'switch'
    'title': '[视频] 调整投屏配置'
    'description': '调整旧版PlayView投屏及新版CASTCONF=2，和后台播放BACKGROUNDPLAY=9分别控制；不保证服务端授权。'
    'default': true
  'navigation_clean':
    'type': 'switch'
    'title': '[界面] 原版底部导航净化'
    'description': '只运行原作者JSON脚本的底部导航分支；会改变原导航排列。'
    'default': true
  'mine_clean':
    'type': 'switch'
    'title': '[界面] 原版我的页净化'
    'description': '运行原作者JSON脚本的我的页/用户展示分支；保留其全部原有行为，不代表真实会员资格。'
    'default': true
  'webpage_ad':
    'type': 'switch'
    'title': '[网页] 清理直播活动网页广告'
    'description': '沿用原作者webpage脚本。'
    'default': true
  'resource_ad':
    'type': 'switch'
    'title': '[界面] 清理顶部活动资源'
    'description': '仅Mock资源top/activity、patch/tab系列接口，与视频横幅独立。'
    'default': true
  'game_ad':
    'type': 'switch'
    'title': '[游戏] 清理直播游戏大卡片'
    'description': '仅Mock原作者已匹配的game/live/large_card_material接口。'
    'default': true
  'p2p_block':
    'type': 'switch'
    'title': '[隐私] 净化P2P tracker配置'
    'description': '仅控制JSON tracker改写；原QUIC/P2P分流规则仍保留。'
    'default': true
  'log_level':
    'type': 'select'
    'title': '日志等级'
    'default': '4'
    'options':
      - 'value': '1'
        'label': 'DEBUG'
      - 'value': '2'
        'label': 'INFO'
      - 'value': '3'
        'label': 'WARN'
      - 'value': '4'
        'label': 'ERROR'
      - 'value': '5'
        'label': 'OFF'
  'script_engine':
    'type': 'select'
    'title': '[高级] 脚本引擎'
    'description': '默认自动以保留原版兼容性。可自行尝试JSC，但不保证原远程空降/界面脚本支持；tvOS不要选择WebKit。'
    'default': 'auto'
    'options':
      - 'value': 'auto'
        'label': '自动（兼容优先）'
      - 'value': 'jsc'
        'label': 'JavaScriptCore（需实测）'
      - 'value': 'webkit'
        'label': 'WebKit（iOS/macOS）'
  'grpc_max_size':
    'type': 'input'
    'value-type': 'integer'
    'title': '[高级] gRPC 输入上限（字节）'
    'description': '超过上限原样放行，可能不再过滤该响应；调高会增加内存占用。'
    'default': 524288
    'minimum': 65536
    'maximum': 2097152
  'decode_max_size':
    'type': 'input'
    'value-type': 'integer'
    'title': '[高级] gRPC 解压与输出上限（字节）'
    'description': '超过上限原样放行，可能不再过滤该响应；调高会增加内存占用。'
    'default': 1048576
    'minimum': 131072
    'maximum': 4194304
  'json_max_size':
    'type': 'input'
    'value-type': 'integer'
    'title': '[高级] JSON 响应上限（字节）'
    'description': '超过上限原样放行，可能不再过滤该响应；调高会增加内存占用。'
    'default': 1048576
    'minimum': 131072
    'maximum': 4194304
'rules':
  - 'AND,((DOMAIN-SUFFIX,bilibili.com),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN-SUFFIX,biliapi.net),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN-SUFFIX,biliapi.com),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN-SUFFIX,biligame.com),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN-SUFFIX,bilivideo.com),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN-SUFFIX,bilivideo.cn),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN-SUFFIX,hdslb.com),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN-SUFFIX,b23.tv),(PROTOCOL,QUIC)),REJECT'
  - 'DOMAIN,bsbsb.top,${args.airborne_policy}'
  - 'DOMAIN,api.biliapi.com,REJECT'
  - 'DOMAIN,app.biliapi.com,REJECT'
  - 'DOMAIN,api.biliapi.net,REJECT'
  - 'DOMAIN,app.biliapi.net,REJECT'
  - 'AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT'
  - 'AND,((OR,((DOMAIN-SUFFIX,bilivideo.com),(DOMAIN-SUFFIX,bilivideo.cn))),(DST-PORT,4480)),REJECT'
  - 'AND,((OR,((DOMAIN-SUFFIX,bilivideo.com),(DOMAIN-SUFFIX,bilivideo.cn))),(DST-PORT,4483)),REJECT'
  - 'AND,((OR,((DOMAIN-SUFFIX,bilivideo.com),(DOMAIN-SUFFIX,bilivideo.cn))),(DST-PORT,9102)),REJECT'
'http':
  'mitm':
    - 'app.bilibili.com'
    - 'api.bilibili.com'
    - 'api.live.bilibili.com'
    - 'api.vc.bilibili.com'
    - 'app.biliapi.net'
    - 'app.biliapi.com'
    - 'api.biliapi.net'
    - 'grpc.biliapi.net'
    - 'grpc.bilibili.com'
    - 'cm.bilibili.com'
    - 'adtrack.qianwen.com'
    - 'tkio-redirect.solar-engine.com'
    - 'www.bilibili.com'
    - 'line3-h5-mobile-api.biligame.com'
    - 'api.biliapi.com'
    - 'manga.bilibili.com'
  'force-http-engine':
    - 'app.bilibili.com'
    - 'api.bilibili.com'
    - 'api.live.bilibili.com'
    - 'api.vc.bilibili.com'
    - 'app.biliapi.net'
    - 'app.biliapi.com'
    - 'api.biliapi.net'
    - 'grpc.biliapi.net'
    - 'grpc.bilibili.com'
    - 'cm.bilibili.com'
    - 'www.bilibili.com'
    - 'line3-h5-mobile-api.biligame.com'
    - 'api.biliapi.com'
    - 'manga.bilibili.com'
