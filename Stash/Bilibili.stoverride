name: '哔哩哔哩去广告 · 可调参数'
desc: |-
  基于 kokoryh/Sparkle 移植。
  过滤广告、移除青少年模式弹窗与互动弹幕、
  解锁后台播放与投屏、移除无用功能与链接跟踪参数，
  支持空降助手跳过视频中插入的广告。
  使用前需启用 MitM（建议 MitM over HTTP/2），iOS 15 及以上。
version: '1.0.0'
author: 'kokoryh[https://github.com/kokoryh]'
homepage: 'https://github.com/kokoryh/Sparkle'
openUrl: 'https://apps.apple.com/app/id736536022'
icon: 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png'
category: 'ad'

arguments-version: 1
arguments:
  airborne:
    type: switch
    title: 空降助手
    description: 跳过视频中插入的广告（依赖第三方服务器 bsbsb.top）
    default: true
  airborne_policy:
    type: input
    title: 空降助手策略
    description: 填写你的代理组名，默认 DIRECT 直连
    default: DIRECT
  purify_comment:
    type: switch
    title: 过滤置顶评论广告
    default: true
  log_level:
    type: select
    title: 日志等级
    default: '4'
    options:
      - value: '1'
        label: DEBUG
      - value: '2'
        label: INFO
      - value: '3'
        label: WARN
      - value: '4'
        label: ERROR
      - value: '5'
        label: OFF

rules:
  - 'DOMAIN,bsbsb.top,${args.airborne_policy}'
  - 'DOMAIN,api.biliapi.com,REJECT'
  - 'DOMAIN,app.biliapi.com,REJECT'
  - 'DOMAIN,api.biliapi.net,REJECT'
  - 'DOMAIN,app.biliapi.net,REJECT'
  - 'AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT'
  - 'DST-PORT,4480,REJECT'
  - 'DST-PORT,4483,REJECT'
  - 'DST-PORT,9102,REJECT'

http:
  mitm:
    - 'grpc.biliapi.net:443'
    - 'app.bilibili.com:443'
    - 'api.bilibili.com:443'
    - 'api.live.bilibili.com:443'
    - 'www.bilibili.com:443'
    - 'line3-h5-mobile-api.biligame.com:443'
  script:
    # —— Map Local：直接返回 mock 响应 ——
    - name: bilibili.mock
      type: request
      match: '^https:\/\/(?:app\.bilibili\.com\/x\/v2\/splash\/list|ap[ip]\.bilibili\.com\/x\/|api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive|api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info|line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material|grpc\.biliapi\.net\/bilibili\.app\.)'
      script: |-
        const url = $request.url;
        const grpcMock = [
          ['/bilibili\\.app\\.interface\\.v1\\.Teenagers/ModeStatus$', 'AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA'],
          ['/bilibili\\.app\\.interface\\.v1\\.Search/DefaultWords$', 'AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE='],
          ['/bilibili\\.app\\.(?:view\\.v1\\.View/TFInfo|viewunite\\.v1\\.View/(?:PlayPause|ViewEndPage))$', 'AAAAAAA='],
        ];
        for (const [re, b64] of grpcMock) {
          if (new RegExp(re).test(url)) {
            const bin = atob(b64);
            const bytes = new Uint8Array(bin.length);
            for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
            $done({ response: { status: 200, headers: { 'content-type': 'application/grpc', 'grpc-status': '0' }, bodyBytes: bytes } });
            return;
          }
        }
        const jsonResp = (obj) => ({ response: { status: 200, headers: { 'content-type': 'application/json' }, body: JSON.stringify(obj) } });
        if (/^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?/.test(url)) {
          $done(jsonResp({ code: 0, message: 'OK', ttl: 1, data: { max_time: 0, min_interval: 31536000, pull_interval: 31536000, keep_ids: [], show: [], list: [{}], splash_request_id: '' } }));
          return;
        }
        if (/^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)\?/.test(url)) {
          $done(jsonResp({ code: -404, message: '-404', ttl: 1, data: null }));
          return;
        }
        if (/^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?/.test(url)) {
          $done(jsonResp({ code: 0, data: { closeType: 'close_win', container: [], showTime: '' }, message: 'success' }));
          return;
        }
        if (/^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?/.test(url)) {
          $done(jsonResp({}));
          return;
        }
        if (/^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?/.test(url)) {
          $done(jsonResp({ code: 0, message: 'success' }));
          return;
        }
        $done({});
    # —— Body Rewrite：改写 JSON 响应 ——
    - name: bilibili.jq
      type: response
      require-body: true
      match: '^https:\/\/(?:api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf|api\.bilibili\.com\/x\/pd-proxy\/tracker|api\.bilibili\.com\/pgc\/(?:view\/v2\/app\/season|page\/channel))\?'
      script: |-
        const url = $request.url;
        let data;
        try { data = JSON.parse($response.body); } catch (e) { $done({}); return; }
        const finish = () => $done({ body: JSON.stringify(data) });
        if (/tracker\/conf\?/.test(url)) {
          if (data.data) data.data.domains = ['wss://tracker.chat.bilibili.com'];
          return finish();
        }
        if (/pd-proxy\/tracker\?/.test(url)) {
          if (Array.isArray(data.data)) {
            data.data.forEach((row) => { if (Array.isArray(row)) row.forEach((_, j) => { row[j] = 'stun.chat.bilibili.com:3478'; }); });
          }
          return finish();
        }
        if (/pgc\/view\/v2\/app\/season\?/.test(url)) {
          if (data.data) delete data.data.payment;
          return finish();
        }
        if (/pgc\/page\/channel\?/.test(url)) {
          if (data.data && Array.isArray(data.data.modules)) {
            data.data.modules = data.data.modules
              .filter((m) => m.type !== 'TIP')
              .map((m) => {
                if (m.type === 'BANNER' && m.module_data && Array.isArray(m.module_data.items)) {
                  m.module_data.items = m.module_data.items.filter((it) => !(it.url && it.url.startsWith('https://www.bilibili.com/blackboard/era/')));
                }
                return m;
              });
          }
          return finish();
        }
        $done({});
    # —— protobuf 请求（空降助手 + 评论净化）——
    - name: bilibili.protobuf.request
      type: request
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '{"purifyComment":${args.purify_comment|json},"logLevel":"${args.log_level}"}'
      match: '^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:community\.service\.dm\.v1\.DM\/DmSegMobile|app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$'
    # —— protobuf 响应（净化各类 protobuf 接口）——
    - name: bilibili.protobuf.response
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '{"displayUpList":"auto","purifyComment":${args.purify_comment|json},"sponsorBlock":${args.airborne|json},"logLevel":"${args.log_level}"}'
      match: '^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$'
    # —— JSON 界面改写（首页信息流 / 我的页 / 直播）——
    - name: bilibili.json
      type: response
      require-body: true
      max-size: -1
      argument: '{"showCreatorHub":0}'
      match: '^https:\/\/app\.bilibili\.com\/x\/(?:resource\/show\/tab\/v2|v2\/(?:splash\/(?:show|event\/list2)|feed\/index(?:\/story)?|account\/(?:mine(?:\/ipad)?|myinfo)))\?'
    # —— 直播间网页广告 ——
    - name: bilibili.webpage
      type: response
      require-body: true
      max-size: -1
      match: '^https:\/\/www\.bilibili\.com\/blackboard\/era\/.+\.html\?'

script-providers:
  bilibili.protobuf.request:
    url: 'https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js'
    interval: 86400
  bilibili.protobuf.response:
    url: 'https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js'
    interval: 86400
  bilibili.json:
    url: 'https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js'
    interval: 86400
  bilibili.webpage:
    url: 'https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/webpage.bilibili.js'
    interval: 86400
