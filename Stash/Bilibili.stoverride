  'rulehub.bilibili.enhanced.json':
    'payload': "/* Rule-Hub Bilibili JSON enhancement, 2026-10-24. SPDX-License-Identifier: GPL-3.0-or-later. */

      (function () {

      \  'use strict';

      \  let options, body;

      \  try { options = JSON.parse(String($argument)); body = JSON.parse($response.body); }

      \  catch (_) { $done({}); return; }

      \  if (options.master_enabled !== true) { $done({}); return; }

      \  const on = key => options[key] === true;

      \  const path = String($request.url).replace(/^https?:\\/\\/[^/]+/, '').split('?')[0];

      \  const isLiveResponse = path.startsWith('/xlive/');

      \  const tracking = new Set(['bsource','from_comid','from_source','from_spmid','from_trackid','live_from','msource','report_flow_data','search_from_source','seid','share_medium','share_plat','share_session_id','share_source','share_tag','spm_id_from','spmid','track_id','trackid','unique_k','vd_source']);

      \  const linkFields = new Set(['appUrlSchema','app_url_schema','jumpUri','jumpUrl','jump_uri','jump_url','link','pcUrl','pc_url','uri','url']);

      \  let touched = false, visited = 0;

      \  const remove = (value, key) => { if (value && Object.prototype.hasOwnProperty.call(value,key)) { delete value[key]; touched = true; } };

      \  function sanitize(value, preloadOnly) {

      \    if (typeof value !== 'string') return value;

      \    const hashAt = value.indexOf('#'), suffix = hashAt < 0 ? '' : value.slice(hashAt);

      \    const base = hashAt < 0 ? value : value.slice(0,hashAt), at = base.indexOf('?');

      \    if (at < 0) return value;

      \    const pairs = base.slice(at+1).split('&').filter(part => {

      \      let name = part.split('=')[0];

      \      try { name = decodeURIComponent(name); } catch (_) {}

      \      return preloadOnly ? name.toLowerCase() !== 'trackid' : !tracking.has(name.toLowerCase());

      \    });

      \    return base.slice(0,at) + (pairs.length ? '?' + pairs.join('&') : '') + suffix;

      \  }

      \  function clean(value, depth) {

      \    if (!value || typeof value !== 'object' || depth > 18 || ++visited > 30000) return;

      \    if (Array.isArray(value)) { for (const item of value) clean(item,depth+1); return; }

      \    for (const key of Object.keys(value)) {

      \      const child = value[key];

      \      if (on('privacy_tracking') && ['trackid','track_id','report_flow_data'].includes(key)) { remove(value,key); continue; }

      \      if (on('privacy_tracking') && linkFields.has(key) && typeof child === 'string') {

      \        const next = sanitize(child,false); if (next !== child) { value[key] = next; touched = true; }

      \      }

      \      if (isLiveResponse && on('live_callbacks') && ['show_callback','click_callback'].includes(key)) { remove(value,key); continue; }

      \      if (isLiveResponse && on('live_preload_tracking') && key === 'subtitle_style' && child && typeof child.link === 'string') {

      \        const next = sanitize(child.link,true); if (next !== child.link) { child.link = next; touched = true; }

      \      }

      \      clean(child,depth+1);

      \    }

      \  }

      \  const ad = item => !!item && (String(item.card_type || '').startsWith('cm_') || String(item.card_goto || '').startsWith('ad_') || item.goto === 'ad' || item.is_ad === true);

      \  const liveAd = item => {

      \    if (!item) return false;

      \    const meta = item.ad_transparent_content;

      \    const hasMeta = typeof meta === 'string' ? meta.trim().length > 0 : meta && typeof meta === 'object' ? Object.keys(meta).length > 0 : meta === true;

      \    return [true,1,'1'].includes(item.is_ad) || [true,1,'1'].includes(item.show_ad_icon) || hasMeta;

      \  };

      \  const filter = (object,key,predicate) => {

      \    if (!object || !Array.isArray(object[key])) return;

      \    const before = object[key], after = before.filter(predicate);

      \    if (after.length !== before.length) { object[key] = after; touched = true; }

      \  };

      \  const data = body.data;

      \  try {

      \    if (path.startsWith('/x/v2/splash/') && on('splash_ad') && data) {

      \      for (const key of ['account','event_list','preload','show']) remove(data,key);

      \      if (Array.isArray(data.list)) for (const item of data.list) { if (!item || typeof item !== 'object') continue; item.duration = 0; item.enable_pre_download = false; touched = true; }

      \      data.max_time = 0; touched = true;

      \    }

      \    if (path === '/x/v2/feed/index' && data && Array.isArray(data.items)) {

      \      const uids = new Set(String(options.feed_block_uids || '').split(/[,，;；\\s]+/).filter(value => /^\\d+$/.test(value)));

      \      filter(data,'items',item => {

      \        if (!item || typeof item !== 'object') return true;

      \        if (on('feed_ad') && ad(item)) return false;

      \        if (on('feed_activity') && ['banner_v8','banner_ipad_v8'].includes(item.card_type)) return false;

      \        if (on('feed_vertical') && item.goto === 'vertical_av') return false;

      \        if (on('feed_uid_filter') && item.card_goto === 'live' && uids.has(String(item.args && item.args.up_id))) return false;

      \        if (on('feed_ad')) filter(item,'banner_item',banner => !['ad','ad_inline'].includes(banner && banner.type));

      \        return true;

      \      });

      \    }

      \    if (/^\\/x\\/v2\\/feed\\/index\\/(?:relate\\/)?story$/.test(path) && data && Array.isArray(data.items)) {

      \      if (on('story_ad')) filter(data,'items',item => !ad(item) && !['vertical_ad_av','vertical_ad_picture','vertical_ad_live','vertical_pgc'].includes(item && item.card_goto));

      \      if (on('story_commercial')) for (const item of data.items) {

      \        if (!item || typeof item !== 'object') continue;

      \        for (const key of ['story_cart_icon','free_flow_toast','course_info','game_info']) remove(item,key);

      \        filter(item,'share_bottom_button',button => !(button && button.type === 20 && Array.isArray(button.button_metas) && button.button_metas.some(meta => meta && (meta.text === '助TA必火' || /cm\\.bilibili\\.com\\/fly-h5/.test(meta.link || '')))));

      \      }

      \    }

      \    if (path === '/x/v2/search/square' && on('search_hot') && Array.isArray(body.data)) filter(body,'data',item => !item || item.type !== 'trending');

      \    if (path === '/x/web-interface/wbi/index/top/feed/rcmd' && on('feed_ad')) filter(data,'item',item => !ad(item));

      \    if (path === '/xlive/app-interface/v2/index/feed' && on('live_ad')) filter(data,'card_list',item => !['banner_v2','activity_card_v1'].includes(item && item.card_type) && !liveAd(item && item.card_data && item.card_data.small_card_v1));

      \    if (path === '/xlive/app-interface/v2/room/recList' && on('live_ad')) filter(data,'list',item => !liveAd(item));

      \    if (path === '/xlive/app-room/v1/index/getInfoByRoom' && data && on('live_ad')) {

      \      for (const key of ['big_card_info','activity_banner_info','function_card']) remove(data,key);

      \      if (data.shopping_info) { data.shopping_info.is_show = 0; touched = true; }

      \      if (data.new_tab_info) filter(data.new_tab_info,'outer_list',item => item && item.biz_id !== 33);

      \    }

      \    if (/^\\/pgc\\/page\\/(?:bangumi|cinema\\/tab|channel)$/.test(path) && on('pgc_ad')) {

      \      const root = body.result || body.data;

      \      if (root && Array.isArray(root.modules)) {

      \        filter(root,'modules',module => module && module.type !== 'TIP');

      \        for (const module of root.modules) {

      \          const holder = module.module_data || module;

      \          if (String(module.style || module.type || '').toLowerCase().startsWith('banner')) filter(holder,'items',item => !item || !/bilibili\\.com\\/blackboard\\/era\\//.test(item.url || item.link || ''));

      \        }

      \      }

      \    }

      \    if (path === '/xlive/open-interface/v2/tracker/conf' && on('p2p_block') && data) { data.domains = ['wss://tracker.chat.bilibili.com']; touched = true; }

      \    if (path === '/x/pd-proxy/tracker' && on('p2p_block') && Array.isArray(data)) for (const row of data) if (Array.isArray(row)) { for (let i=0;i<row.length;i++) row[i] = 'stun.chat.bilibili.com:3478'; touched = true; }

      \    if (path === '/pgc/view/v2/app/season' && on('pgc_player_tips')) remove(data,'payment');

      \    if (on('privacy_tracking') || on('live_callbacks') || on('live_preload_tracking')) clean(body,0);

      \    $done(touched ? {body:JSON.stringify(body)} : {});

      \  } catch (error) {

      \    if (String(options.log_level) !== '5') console.log('[RuleHub JSON] 原样放行：' + error);

      \    $done({});

      \  }

      })();\n"
