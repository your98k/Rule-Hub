name: '美团'
desc: |-
  过滤美团广告，需卸载重装。
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/MeiTuan.png'
date: '2026-10-25 21:00'
openUrl: 'https://apps.apple.com/app/id423084029'
category: '去广告'
# 由 Loon 插件自动转换：MeiTuan.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：ZenmoFeiShi[https://github.com/ZenmoFeiShi]
http:
  url-rewrite:
    - '^https?://(httpdns|httpdnsvip|httpdnsmultiapi|httpdnsmultiapivip)\.meituan\.com/ - reject'
  mitm:
    - 'apimobile.meituan.com'
    - 'feedguess.meituan.com'
    - 'mop.meituan.com'
    - 'mt-personalcenter.meituan.com'
    - 'assistify.meituan.com'
    - 'httpdns.meituan.com'
    - 'httpdnsmultiapi.meituan.com'
    - 'meituan.com'
  script:
    - name: 'MeiTuan'
      match: '^https?://apimobile\.meituan\.com/aggroup/indexTab'
      type: 'response'
      timeout: 60
    - name: 'MeiTuan'
      match: '^https?://feedguess\.meituan\.com/lycoris/scene/(gwc_feed1_2265|personalcenter_2154)(\?|$)'
      type: 'response'
      timeout: 60
    - name: 'MeiTuan'
      match: '^https?://mt-personalcenter\.meituan\.com/usercenter/display'
      type: 'response'
      timeout: 60
    - name: 'MeiTuan'
      match: '^https?://apimobile\.meituan\.com/group/v1/deal/searchpage/defaultword'
      type: 'response'
      timeout: 60
    - name: 'MeiTuan'
      match: '^https?://apimobile\.meituan\.com/group/v1/deal/searchpage/hotword/city/divide/hotrecommend/'
      type: 'response'
      timeout: 60
    - name: 'MeiTuan'
      match: '^https?://assistify\.meituan\.com/assistant/getAppClientHornConfig'
      type: 'response'
      timeout: 60
    - name: 'MeiTuan'
      match: '^https?://mop\.meituan\.com/mop/entry/shoppingCartEntry'
      type: 'response'
      timeout: 60
    - name: 'MeiTuan'
      match: '^https?://mop\.meituan\.com/api/entryModule/startupPicture'
      type: 'response'
      timeout: 60
rules:
  - 'DOMAIN,shark-mt.meituan.com,REJECT'
  - 'DOMAIN,shark-default.meituan.com,REJECT'
  - 'DOMAIN,shark-dp.meituan.com,REJECT'
  - 'DOMAIN,shark-ps.meituan.com,REJECT'
  - 'DOMAIN,shark-wm.sankuai.com,REJECT'
  - 'DOMAIN,shark.dianping.com,REJECT'
  - 'DOMAIN-WILDCARD,mquic-*.meituan.com,REJECT'
  - 'DOMAIN,httpdnsmultiapi.meituan.com,REJECT'
  - 'DOMAIN,httpdnsmultiapivip.meituan.com,REJECT'
  - 'DOMAIN,httpdns.meituan.com,REJECT'
  - 'DOMAIN,httpdnsvip.meituan.com,REJECT'
  - 'DOMAIN,dnspod.meituan.httpdns.qcloud.com,REJECT'
  - 'DOMAIN,dnspod.meituan.httpdns.start.qcloud.com,REJECT'
  - 'IP-CIDR,202.90.108.13/32,REJECT,no-resolve'
