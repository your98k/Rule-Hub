name: '彩云天气Pro'
desc: |-
  过滤彩云天气广告，解锁SVIP功能。\nApp版本低于7.20.2。
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ColorfulCloudsWeatherPro.png'
date: '2026-10-02 12:00'
openUrl: 'https://apps.apple.com/app/id1067198688'
category: '去广告, 解锁会员'
# 由 Loon 插件自动转换：ColorfulCloudsWeatherPro.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：RuCu6[https://github.com/RuCu6], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
http:
  url-rewrite:
    - '^https://biz\.cyapi\.cn/(p/v1/entries|p/v1/trial_card/info|v2/product) - reject-dict'
    - '^https://starplucker\.cyapi\.cn/v3/(config/cypage/\w+/conditions|notification/message_center|operation/homefeatures) - reject-dict'
  mitm:
    - 'api.caiyunapp.com'
    - '*.cyapi.cn'
  script:
    - name: 'ColorfulCloudsWeatherPro'
      match: '^https://wrapper\.cyapi\.cn/v1/(nafp/origin_images|satellite)\?'
      type: 'request'
    - name: 'ColorfulCloudsWeatherPro'
      match: '^https://api\.caiyunapp\.com/v1/activity\?'
      type: 'response'
    - name: 'ColorfulCloudsWeatherPro'
      match: '^https://biz\.cyapi\.cn/(api/v1/user_detail|p/v1/vip_info|v2/user)'
      type: 'response'
    - name: 'ColorfulCloudsWeatherPro'
      match: '^https://wrapper\.cyapi\.cn/v1/activity\?'
      type: 'response'
rules:
  - 'DOMAIN,abyss.cyapi.cn,REJECT'
  - 'DOMAIN,ad.cyapi.cn,REJECT'
  - 'DOMAIN,gather.colorfulclouds.net,REJECT'
script-providers:
  ColorfulCloudsWeatherPro:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/ColorfulCloudsWeatherPro.js'
    interval: 86400
