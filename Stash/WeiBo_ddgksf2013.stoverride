name: '微博'
desc: |-
  微博增强
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/WeiBo.png'
date: '2026-10-19 20:00'
open-url: 'https://apps.apple.com/app/id350962117'
category: '去广告'
# 由 Loon 插件自动转换：WeiBo_ddgksf2013.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：ddgksf2013[https://github.com/ddgksf2013]
http:
  mitm:
    - 'api.weibo.cn'
    - 'bootpreload.uve.weibo.com'
    - 'wbapp.uve.weibo.com'
  script:
    - name: 'weibo_json'
      match: '^https://api\.weibo\.cn/__qx_weibo_settings__/(?:api/config)?(?=[?#]|$)'
      type: 'request'
      timeout: 60
    - name: 'weibo_json'
      match: '^https://api\.weibo\.cn/__qx_weibo_settings__/api/(?:save|reset)(?=[?#]|$)'
      type: 'request'
      timeout: 60
    - name: 'weibo_json'
      match: '^https?://api\.weibo\.cn(?:/2/statuses/container_timeline_hot|/2/guest/container_timeline_hot|/2/statuses/container_timeline_unread|/2/statuses/container_timeline|/2/live/media_homelist|/2/remind/hometab_dot|/2/remind/unread_count|/2/statuses/container_detail|/2/statuses/container_detail_comment|/2/comments/build_comments|/2/search/finder|/2/search/container_timeline|/2/search/container_discover|/2/!/was/finder/searchbarchange|/2/cardlist|/2/searchall|/2/profile/me|/2/video/flow_stream|/2/video/flow_stream_cache|/2/push/daily|/2/push/active|/2/guest/push_active|/2/groups/allgroups/v2|/2/client/abserver_list|/2/checkin/show|/2/video/remind_info|/2/video/home_channels)(?=[?#]|$)'
      type: 'response'
      timeout: 60
    - name: 'weibo_json'
      match: '^https?://bootpreload\.uve\.weibo\.com(?:/v2/ad/preload)(?=[?#]|$)'
      type: 'response'
      timeout: 60
    - name: 'weibo_json'
      match: '^https?://wbapp\.uve\.weibo\.com(?:/wbapplua/wbpullad\.lua)(?=[?#]|$)'
      type: 'response'
      timeout: 60
script-providers:
  weibo_json:
    url: 'https://raw.githubusercontent.com/harmonizr/loon-plugins/main/scripts/ddgksf2013.top/scripts/weibo_json.js'
    interval: 86400
