name: '王者营地 去广告'
desc: |-
  移植 loonlab 插件仓库 HOK_GameHelper.lpx：3 条 url-rewrite、0 条 body-rewrite，全部为 Stash 原生声明式配置。
  覆盖 1 个域名，使用前请在 Stash 信任 MitM CA。
  来源：loonlab 插件仓库 HOK_GameHelper.lpx。
openUrl: 'https://apps.apple.com/app/id1224907800'
author: 'loonlab · Loon→Stash 原生适配'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

http:
  mitm:
    - 'app.mval.qq.com'
  url-rewrite:
    - '^https://app\.mval\.qq\.com/go/recommend/platflashbox\? - reject-dict'
    - '^https://app\.mval\.qq\.com/go/mlol_news/search/varcache_hotV\d\? - reject-dict'
    - '^https://app\.mval\.qq\.com/go/customize_search/article_rank\? - reject-dict'
