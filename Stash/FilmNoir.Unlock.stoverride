name: FilmNoir · 内购权益注入
desc: |-
  只对 FilmNoir(app.filmnoir.appstore)生效,在本机把 RevenueCat 返回的
  customer info 补成已购状态:plus / premier 权益永久有效,订阅与永久购买
  记录一并补齐。

  · 全程本机处理,请求与收据不外发任何第三方服务。
  · 只改响应,不改请求;其他 App、非 JSON 响应、结构不符时一律原样放行,
    所以不会出现内购页白屏或报错。
  · 只影响 App 客户端显示,不改 Apple 真实订阅;系统订阅页的到期日不受影响。
  · 走 HTTP/3(QUIC)的流量脚本收不到;RevenueCat SDK 走 URLSession + HTTP/2,
    正常情况不受影响。若某次完全没反应,先看 Stash 脚本日志有没有 filmnoir 记录。
  · 自定义参数仅支持 Stash 3.7 及以上版本。
icon: 'https://raw.githubusercontent.com/fishdown/Icon/refs/heads/master/app/RevenueCat.png'
category: '内购解锁'
date: '2026-11-18'
version: '1.0.0'
author: 'your98k'

arguments-version: 1
arguments:
  enable:
    type: switch
    title: 启用注入
    description: 关闭后本覆写完全放行,用来快速回退。
    default: true
  bundle:
    type: input
    title: 目标 App 包名
    description: 只处理 X-Client-Bundle-ID 等于该值的请求;留空则只靠 UA 识别。
    default: 'app.filmnoir.appstore'
    required: true
    max-length: 128
  ua:
    type: input
    title: UA 兜底前缀
    description: 请求没有包名头时,用 User-Agent 前缀识别。填 - 表示不做 UA 兜底。
    default: 'FilmNoir/'
    max-length: 128
  entitlements:
    type: input
    title: 权益名
    description: 要注入的 entitlements 键名,多个用英文逗号分隔。
    default: 'plus,premier'
    required: true
    max-length: 256
  mode:
    type: select
    title: 权益挂载方式
    description: both 第一项挂年订阅、其余挂永久;annual 全挂年订阅;lifetime 全挂永久。
    default: both
    options:
      - value: both
        label: both(年订阅 + 永久)
      - value: annual
        label: annual(只有年订阅)
      - value: lifetime
        label: lifetime(只有永久)
  product_annual:
    type: input
    title: 年订阅商品 ID
    description: 与抓包中的商品 ID 一致。
    default: 'app.filmnoir.appstore.plus.annual'
    max-length: 256
  product_lifetime:
    type: input
    title: 永久购买商品 ID
    description: 写进 non_subscriptions 与 other_purchases 的商品 ID。
    default: 'app.filmnoir.appstore.lifetime'
    max-length: 256
  expiry:
    type: select
    title: 到期时间
    description: 2099 写 2099-12-31;nil 写 null(部分老 SDK 视为永久)。
    default: '2099'
    options:
      - value: '2099'
        label: 2099-12-31
      - value: nil
        label: null(永久)
  verbose:
    type: switch
    title: 输出脚本日志
    description: 排查是否命中时打开,Stash 脚本日志里能看到每次判定结果。
    default: false

http:
  mitm:
    - 'api.revenuecat.com'
  script:
    - name: filmnoir-entitlement
      match: '^https://api\.revenuecat\.com/v1/(subscribers|receipts)'
      type: response
      require-body: true
      binary-mode: false
      max-size: 4194304
      timeout: 10
      engine: auto
      argument: '{"enable":${args.enable|json},"bundle":${args.bundle|json},"ua":${args.ua|json},"entitlements":${args.entitlements|json},"product_annual":${args.product_annual|json},"product_lifetime":${args.product_lifetime|json},"mode":${args.mode|json},"expiry":${args.expiry|json},"verbose":${args.verbose|json}}'

script-providers:
  filmnoir-entitlement:
    payload: |-
      /**
       * FilmNoir · 本地内购权益注入(Stash 版,署名 your98k)
       *
       * 与 Reven 转发版的区别:
       *   1. 不把任何请求转发到第三方服务,收据、授权头、设备标识全部留在本机;
       *   2. 不再自己造一份响应,而是在 App 收到的真实 RevenueCat 响应上补权益
       *      (原响应里的 user、offerings 引用、字段全部保留),所以内购页不会因为
       *      结构对不上而报错;
       *   3. 只有 bundle id / User-Agent 命中 FilmNoir 才处理,其他 App 一条都不碰;
       *   4. 任何一步不符合预期(JSON 解析失败、不是 customer info 结构、开关关闭)
       *      都原样放行,$done({}),页面最多是没解锁,不会白屏或报错。
       *
       * Stash 参数(JSON):
       *   {"enable":true,"bundle":"app.filmnoir.appstore","ua":"FilmNoir/",
       *    "entitlements":"plus,premier","product_lifetime":"app.filmnoir.appstore.lifetime",
       *    "product_annual":"app.filmnoir.appstore.plus.annual",
       *    "mode":"both","expiry":"2099","verbose":false}
       */

      (function () {
        var PRODUCT_FALLBACK = 'app.filmnoir.appstore.lifetime';
        var ANNUAL_FALLBACK = 'app.filmnoir.appstore.plus.annual';
        var DROP_HEADERS = {
          'content-length': 1,
          'content-encoding': 1,
          'transfer-encoding': 1,
          'connection': 1,
          'keep-alive': 1,
          'etag': 1,
          'digest': 1,
          'content-md5': 1
        };
        var PURCHASE_DATE = '2024-01-01T00:00:00Z';
        var FAR_FUTURE = '2099-12-31T23:59:59Z';

        function log(msg) {
          try {
            if (cfg && cfg.verbose) console.log('filmnoir: ' + msg);
          } catch (e) {
            /* 日志失败不影响主流程 */
          }
        }

        function trim(s) {
          return String(s === undefined || s === null ? '' : s).replace(/^\s+|\s+$/g, '');
        }

        function parseArgument(raw) {
          var out = {
            enable: true,
            bundle: 'app.filmnoir.appstore',
            ua: 'FilmNoir/',
            entitlements: 'plus,premier',
            product_lifetime: PRODUCT_FALLBACK,
            product_annual: ANNUAL_FALLBACK,
            mode: 'both',
            expiry: '2099',
            verbose: false
          };
          if (raw === undefined || raw === null || raw === '') return out;

          var obj = raw;
          if (typeof raw === 'string') {
            var s = trim(raw);
            if (s.charAt(0) !== '{') return out;
            try {
              obj = JSON.parse(s);
            } catch (e) {
              return out;
            }
          }
          if (!obj || typeof obj !== 'object') return out;

          if (obj.enable === false || obj.enable === 'false') out.enable = false;
          if (obj.enable === true || obj.enable === 'true') out.enable = true;

          var keys = ['bundle', 'ua', 'entitlements', 'product_lifetime', 'product_annual', 'mode', 'expiry'];
          for (var i = 0; i < keys.length; i++) {
            var k = keys[i];
            if (obj[k] !== undefined && obj[k] !== null && trim(obj[k]) !== '') out[k] = trim(obj[k]);
          }
          if (obj.verbose === true || obj.verbose === 'true') out.verbose = true;

          if (['lifetime', 'annual', 'both'].indexOf(out.mode) < 0) out.mode = 'both';
          if (['2099', 'nil'].indexOf(out.expiry) < 0) out.expiry = '2099';
          return out;
        }

        var cfg = parseArgument(typeof $argument === 'undefined' ? '' : $argument);

        function done(value) {
          $done(value || {});
        }

        if (!cfg.enable) {
          log('disabled by argument');
          done({});
          return;
        }

        // ── 1. 只认 FilmNoir ────────────────────────────────────────
        function headerValue(headers, name) {
          if (!headers) return '';
          var lower = name.toLowerCase();
          for (var k in headers) {
            if (!Object.prototype.hasOwnProperty.call(headers, k)) continue;
            if (k.toLowerCase() === lower) {
              var v = headers[k];
              return Array.isArray(v) ? String(v[0] || '') : String(v === undefined || v === null ? '' : v);
            }
          }
          return '';
        }

        var reqHeaders = (typeof $request !== 'undefined' && $request && $request.headers) || {};
        var bundle = trim(headerValue(reqHeaders, 'x-client-bundle-id')).toLowerCase();
        var ua = trim(headerValue(reqHeaders, 'user-agent'));
        var wantBundle = cfg.bundle.toLowerCase();
        var matched = false;

        if (bundle) {
          // 有包名就以包名为准:不是 FilmNoir 就不处理,不允许 UA 覆盖包名
          matched = bundle === wantBundle;
        } else {
          matched = ua.length > 0 && ua.toLowerCase().indexOf(cfg.ua.toLowerCase()) === 0;
        }

        if (!matched) {
          log('skip: bundle=' + (bundle || '-') + ' ua=' + (ua ? ua.slice(0, 24) : '-'));
          done({});
          return;
        }

        // ── 2. 只处理 customer info 响应 ────────────────────────────
        var rawBody = typeof $response !== 'undefined' && $response ? $response.body : undefined;
        if (rawBody === undefined || rawBody === null || rawBody === '') {
          log('skip: empty body');
          done({});
          return;
        }

        var text = rawBody;
        if (typeof text !== 'string') {
          try {
            text = new TextDecoder('utf-8').decode(rawBody);
          } catch (e) {
            log('skip: body not decodable');
            done({});
            return;
          }
        }

        var data;
        try {
          data = JSON.parse(text);
        } catch (e) {
          log('skip: body is not json');
          done({});
          return;
        }

        if (!data || typeof data !== 'object' || !data.subscriber || typeof data.subscriber !== 'object') {
          log('skip: no subscriber object');
          done({});
          return;
        }

        // ── 3. 在真实响应上补权益 ──────────────────────────────────
        var subscriber = data.subscriber;
        var expires = cfg.expiry === 'nil' ? null : FAR_FUTURE;

        var entNames = cfg.entitlements.split(',').map(trim).filter(function (n) {
          return n.length > 0;
        });
        if (entNames.length === 0) {
          log('skip: no entitlement names');
          done({});
          return;
        }

        if (!subscriber.entitlements || typeof subscriber.entitlements !== 'object') subscriber.entitlements = {};
        if (!subscriber.subscriptions || typeof subscriber.subscriptions !== 'object') subscriber.subscriptions = {};
        if (!subscriber.non_subscriptions || typeof subscriber.non_subscriptions !== 'object') subscriber.non_subscriptions = {};
        if (!subscriber.other_purchases || typeof subscriber.other_purchases !== 'object') subscriber.other_purchases = {};

        function productFor(index) {
          if (cfg.mode === 'annual') return cfg.product_annual;
          if (cfg.mode === 'lifetime') return cfg.product_lifetime;
          // both:第一项(通常是主权益 plus)挂年订阅,其余挂永久
          return index === 0 ? cfg.product_annual : cfg.product_lifetime;
        }

        var injected = [];

        // 已存在的订阅记录一律延长到未来:有的 SDK 版本读 subscriptions,
        // 有的读 entitlements,两边都补上才不会出现「权益有了但订阅仍显示到期」。
        for (var sk in subscriber.subscriptions) {
          if (!Object.prototype.hasOwnProperty.call(subscriber.subscriptions, sk)) continue;
          var srec = subscriber.subscriptions[sk];
          if (!srec || typeof srec !== 'object') continue;
          srec.expires_date = expires;
          if (srec.period_type === 'trial' || srec.period_type === 'intro') srec.period_type = 'normal';
          srec.unsubscribe_detected_at = null;
          srec.billing_issues_detected_at = null;
          srec.grace_period_expires_date = null;
          srec.is_sandbox = false;
        }

        for (var idx = 0; idx < entNames.length; idx++) {
          var name = entNames[idx];
          var product = productFor(idx);
          var isAnnual = product === cfg.product_annual && cfg.mode !== 'lifetime';

          var prev = subscriber.entitlements[name];
          var merged = prev && typeof prev === 'object' ? prev : {};
          merged.expires_date = expires;
          if (!merged.grace_period_expires_date) merged.grace_period_expires_date = null;
          if (cfg.mode !== 'both' || !merged.product_identifier) merged.product_identifier = product;
          if (!merged.purchase_date) merged.purchase_date = PURCHASE_DATE;
          subscriber.entitlements[name] = merged;

          // 订阅对象:老 SDK 只看 subscriptions,新 SDK 看 non_subscriptions
          var prevSub = subscriber.subscriptions[product];
          var mergedSub = prevSub && typeof prevSub === 'object' ? prevSub : {};
          subscriber.subscriptions[product] = {
            billing_issues_detected_at: null,
            expires_date: expires,
            grace_period_expires_date: null,
            is_sandbox: false,
            original_purchase_date: mergedSub.original_purchase_date || PURCHASE_DATE,
            ownership_type: 'PURCHASED',
            period_type: 'normal',
            purchase_date: mergedSub.purchase_date || PURCHASE_DATE,
            refunded_at: null,
            store: mergedSub.store || 'app_store',
            store_transaction_id: mergedSub.store_transaction_id || (isAnnual ? '2000000000000001' : '2000000000000002'),
            unsubscribe_detected_at: null
          };

          if (!isAnnual) {
            subscriber.non_subscriptions[product] = [
              {
                id: product,
                is_sandbox: false,
                purchase_date: PURCHASE_DATE,
                store: 'app_store',
                store_transaction_id: '2000000000000002'
              }
            ];
            subscriber.other_purchases[product] = { purchase_date: PURCHASE_DATE };
          }

          injected.push(name + ' -> ' + product);
        }

        if (!subscriber.original_app_user_id && subscriber.original_application_version === undefined) {
          subscriber.original_application_version = '1.0';
        }

        var outBody;
        try {
          outBody = JSON.stringify(data);
        } catch (e) {
          log('skip: serialise failed');
          done({});
          return;
        }

        // ── 4. 清掉旧实体头,长度交给引擎重算 ──────────────────────
        var outHeaders = {};
        var srcHeaders = ($response && $response.headers) || {};
        for (var h in srcHeaders) {
          if (!Object.prototype.hasOwnProperty.call(srcHeaders, h)) continue;
          if (DROP_HEADERS[h.toLowerCase()]) continue;
          outHeaders[h] = srcHeaders[h];
        }

        log('ok: ' + injected.join(', ') + ' expires=' + (expires === null ? 'null' : expires));

        $done({ body: outBody, headers: outHeaders });
      })();
