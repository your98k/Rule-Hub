# 来源：https://github.com/fmz200/wool_scripts/blob/main/Loon/plugin/blockAds.plugin
# 小程序来源：https://github.com/fmz200/wool_scripts/blob/main/QuantumultX/rewrite/cleanup.snippet
# 上游提示：携程 App 8.47.0 以上使用 json/tripAds 规则可能导致部分图片加载失败。
name: '携程旅行去广告'
desc: |-
  适配携程 App 开屏广告及微信小程序推广内容。
category: '去广告'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/CtripTravel.png'
openUrl: 'https://apps.apple.com/cn/app/id379395415'
author: '奶思（fmz200，上游规则）；Stash 适配'
homepage: 'https://github.com/fmz200/wool_scripts'

http:
  force-http-engine:
    - 'm.ctrip.com:80'
    - 'ma-adx.ctrip.com:80'
    - 'mbd.baidu.com:80'
  mitm:
    - 'm.ctrip.com'
    - 'ma-adx.ctrip.com'
    - 'mbd.baidu.com'
  url-rewrite:
    # App 更新弹窗接口，上游提示针对旧版 App。
    - '(?i)^https?://m\.ctrip\.com/restapi/soa2/[0-9]{5}/json/getTimeZoneServerIpList\?__gw_os=IOS - reject-200'
    # App 开屏与广告请求；tripAds 在上游注明可能影响新版图片加载。
    - '(?i)^https?://ma-adx\.ctrip\.com/_ma\.gif - reject'
    - '(?i)^https?://m\.ctrip\.com/restapi/soa2/13916/json/tripAds - reject-200'
    - '(?i)^https?://mbd\.baidu\.com/newspage/api/getmobads\?page=landingshare - reject'
    # 微信小程序：广告和热门活动。
    - '^https://m\.ctrip\.com/restapi/soa2/13916/tripAds - reject-dict'
    - '^https://m\.ctrip\.com/restapi/soa2/12673/queryWeChatHotEvent - reject-dict'
  body-rewrite:
    # 等价于上游 Scripts/T3.js：删除顶层 data，保留其余字段。
    - '^https://m\.ctrip\.com/restapi/soa2/13012/getWaterflowInfo response-jq del(.data)'
