name: '小黑盒 去广告'
desc: |-
  移除小黑盒开屏广告接口与热点信息流中的推广条目（按 content_type=27 清理字段）。
  Loon 插件原生适配为 Stash 声明式 url-rewrite + body-rewrite，不依赖任何远程脚本。
  来源：loonlab 插件仓库 XiaoHeiHe.lpx（上游 可莉）。
openUrl: 'https://apps.apple.com/app/id1244505010'
author: '可莉 · Loon→Stash 原生适配'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/XiaoHeiHe.png'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

http:
  mitm:
    - 'api.xiaoheihe.cn'
  url-rewrite:
    - '^https://api\.xiaoheihe\.cn/account/get_ads_info_v2 - reject-dict'
  body-rewrite:
    - '^https://api\.xiaoheihe\.cn/bbs/app/feeds/news response-jq .result.links |= map(if .content_type == 27 then del(.title, .ad_pm, .img_gif, .idea_id, .ad_report, .label, .source, .intranet_only, .ad_cm, .content_type, .PROTOCOL, .img, .ad_ratio) else . end)'
