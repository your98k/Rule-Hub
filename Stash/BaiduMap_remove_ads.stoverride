name: "百度地图"
desc: "移除开屏广告、出行页面推广、周边页面推广、打车页面推广，并精简「我的」页面。需开启 MitM 并信任 Stash 证书；百度地图校验 HTTPS 证书，须使用去除 SSL Pinning 的签名 IPA，App Store 原版无法生效。"
author: "原 Loon 插件：可莉🅥；Stash 适配：your98k"
homepage: "https://kelee.one/Tool/Loon/Lpx/BaiduMap_remove_ads.lpx"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduMap.png"
category: "去广告"
date: "2026-10-31 23:12"
version: "1.0.0"

# =====================================================================
# 说明
# 0. 对照官方原文件适配：kelee.one 2026-10-02 版，loon_version 3.5.1(998)，
#    原文件 SHA256 49522F58512A3D88DA58EB4208793A12D1634C12A626D91D19514AC9AA627DED，
#    共 12 条 Rewrite，全部已对应到下方规则。
# 1. 本文件由 Loon 插件 BaiduMap_remove_ads.lpx（Loon 3.5.1(998) 版）适配为
#    Stash Override。
# 2. 动作对应关系：
#    Loon reject_dict(200)          -> http.url-rewrite 的 reject-dict
#    Loon response-body-json-del    -> http.body-rewrite 的 response-json-del
#    Loon response-body-json-replace-> http.body-rewrite 的 response-json-replace
# 3. 原插件 MitM 列表漏了 maphotel.baidu.com，酒店活动规则实际从未生效，此处补齐。
# 4. 周边页 Result.cards 改为倒序删除，避免顺序删除时索引前移删错卡片。
# 5. body-rewrite 需要 Stash iOS/tvOS 2.8+、macOS 2.8+。
# =====================================================================

http:
  mitm:
    - "afd.baidu.com"
    - "newclient.map.baidu.com"
    - "yongche.baidu.com"
    - "ecom.map.baidu.com"
    - "maphotel.baidu.com"

  url-rewrite:
    # 广告位配置下发（开屏广告）
    - '^https:\/\/afd\.baidu\.com\/afd\/entry\?action=(update|query) - reject-dict'
    # 打车首页营销弹窗入口
    - '^https:\/\/yongche\.baidu\.com\/gomarketing\/api\/popup\/getentrancecordovaurl$ - reject-dict'
    # 打车页协同构建（金刚位推广）
    - '^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/cobuild\/pull\? - reject-dict'
    # 打车页运营腰带
    - '^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/operationgirdle$ - reject-dict'
    # 打车页基础信息中的推广位
    - '^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/baseinfo$ - reject-dict'
    # 电商广告弹窗
    - '^https:\/\/ecom\.map\.baidu\.com\/ad-ops\/afd\/popup\? - reject-dict'
    # 酒店活动推广
    - '^https:\/\/maphotel\.baidu\.com\/hotel\/goextranet\/activity\/detail\? - reject-dict'

  body-rewrite:
    # 首页信息流推广
    - '^https:\/\/newclient\.map\.baidu\.com\/feed\/govui\/rich_content response-json-del data'
    # 顶部通知栏多条推广
    - '^https:\/\/newclient\.map\.baidu\.com\/client\/noticebar\/get\? response-json-del content.multi_data'
    # 「我的」页面整体精简
    - '^https:\/\/newclient\.map\.baidu\.com\/(client\/)?usersystem\/mine\/page\? response-json-replace data {}'
    # 我的页顶部服务卡片广告
    - '^https:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads&type=user_home_new_service response-json-del ads'
    # 周边页 4 个推广卡片（倒序删除，避免索引前移）
    - '^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\? response-json-del Result.cards[9] Result.cards[5] Result.cards[4] Result.cards[1]'
