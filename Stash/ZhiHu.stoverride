name: '知乎'
desc: |-
  过滤知乎广告
author: 'your98k'
homepage: 'https://github.com/harmonizr/loon-plugins'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ZhiHu.png'
date: '2026-10-02 12:00'
open-url: 'https://apps.apple.com/app/id432274380'
category: #!replace
  - '去广告'
# 由 Loon 插件自动转换：ZhiHu.lpx
# 上游主页：https://github.com/harmonizr/loon-plugins
# 原作者：RuCu6[https://github.com/RuCu6], blackmatrix7[https://github.com/blackmatrix7], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
http:
  url-rewrite:
    - '^https://api\.zhihu\.com/ad-style-service/request$ - reject-dict'
    - '^https://api\.zhihu\.com/commercial_api/banners_v\d/app_float_corner\? - reject-dict'
    - '^https://api\.zhihu\.com/next-render\?id=\d+&type=answer - reject-dict'
    - '^https://api\.zhihu\.com/commercial_api/answer/\d+/bottom-v\d$ - reject-dict'
    - '^https://api\.zhihu\.com/search/related_queries/question/\d+$ - reject-dict'
    - '^https://zhida\.zhihu\.com/ai_ingress/knowledge/square/categories/feeds\?categoryId=1%7D$ - reject-dict'
    - '^https://zhida\.zhihu\.com/ai_ingress/ai_chat/guidance$ - reject-dict'
    - '^https://api\.zhihu\.com/content-distribution-core/bubble/common/show$ - reject-dict'
    - '^https://www\.zhihu\.com/api/v\d/members/homepage_card$ - reject-dict'
    - '^https://api\.zhihu\.com/people/homepage_entry_v\d$ - reject-dict'
    - '^https://api\.zhihu\.com/kvip/right/my_card\? - reject-dict'
    - '^https://api\.zhihu\.com/unlimited/go/my_card/v\d\? - reject-dict'
    - '^https://api\.zhihu\.com/commercial_api/ - reject-dict'
    - '^https://api\.zhihu\.com/content-distribution-core/bubble/common/settings - reject-dict'
    - '^https://api\.zhihu\.com/(?:moments/lastread|drama/hot-drama-list) - reject-dict'
    - '^https://api\.zhihu\.com/root/window - reject-dict'
    - '^https://api\.zhihu\.com/(?:bazaar/float_window|market/popovers_v2) - reject-dict'
    - '^https://api\.zhihu\.com/me/guides - reject-dict'
    - '^https://api\.zhihu\.com/people/homepage_entry_v2 - reject-dict'
    - '^https://api\.zhihu\.com/unlimited/go/my_card - reject'
    - '^https://www\.zhihu\.com/appview/v3/zhmore - reject'
    - '^https://api\.zhihu\.com/search/(hot_search|preset_words) - reject-dict'
    - '^https://www\.zhihu\.com/api/v4/search/clicked_recommendation\? - reject-dict'
    - '^https://www\.zhihu\.com/api/v4/search/related_queries/(?:article|answer)/\d+ - reject-dict'
    - '^https://api\.zhihu\.com/comment_v5/(?:articles|answers)/\d+/list-headers - reject-dict'
    - '^https://api\.zhihu\.com/prague/related_suggestion_native/feed\? - reject-dict'
    - '^https://api\.zhihu\.com/related_recommend/feed/waterfall\? - reject-dict'
    - '^https://api\.zhihu\.com/v5\.1/topics/answer/\d+/relation - reject-dict'
    - '^https://api\.zhihu\.com/ab/api/v1/products/zhihu/platforms/ios/config - reject-dict'
    - '^https://api\.zhihu\.com/ad-style-service/request - reject-dict'
    - '^https://appcloud2\.zhihu\.com/v3/resource\?group_name=mp - reject-dict'
    - '^https://api\.zhihu\.com/distribute/rhea/qa_ad_card/h5/recommendation\? - reject-dict'
    - '^https://www\.zhihu\.com/api/v4/hot_recommendation - reject-dict'
    - '^https://www\.zhihu\.com/api/v4/mcn/v2/linkcards\? - reject-dict'
    - '^https://www\.zhihu\.com/api/v4/(?:answers|questions)/\d+/related-readings - reject-dict'
    - '^https://www\.zhihu\.com/commercial_api/banners_v3/mobile_banner - reject-dict'
    - '^https://zhuanlan\.zhihu\.com/api/articles/\d+/recommendation - reject-dict'
  body-rewrite:
    - '^https://m-cloud\.zhihu\.com/api/cloud/zhihu/config/all\? response-jq def drop_keys: {"km_httpdns_new_config_tars":true,"preFetchHttpDns":true,"httpdns_detector_use_concurrent":true,"httpdns_use_memory_cache":true,"httpdns_new_config_tars":true,"coreNetworkConf_useTars":true,"km_coreNetworkConf_useTars":true,"sugarQuicConfig":true,"quic_dns_detect_enable":true,"quicMixAB":true,"quic_downgrade_enable":true,"quic_priority_strategy":true,"quic_check_health_enable":true,"tquic_configuration":true,"networkExprimentList":true,"tars_ab_list":true,"zaSetExtraRequestHeader":true}; .data.configs |= map(select((drop_keys[.configKey] // false) | not) | if (.configValue | type) == "object" then del(.configValue.delayHttpdns, .configValue.dnsParser, .configValue.HTTPDNS) else . end)'
    - '^https://api\.zhihu\.com/root/tab/v\d(?:\?.+)?$ response-jq .tab_list |= map(select(.tab_type == "follow" or .tab_type == "recommend" or .tab_type == "hot" or .tab_type == "ring_tab"))'
    - '^https://api\.zhihu\.com/topstory/recommend\? response-jq .data |= map(select(.type == "ComponentCard"))'
    - '^https://api\.zhihu\.com/questions/\d+/feeds\? response-json-del ad_info'
    - '^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ response-json-del third_business'
    - '^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ response-json-del float_search_word'
    - '^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ response-jq .structured_content.segments |= map(select(.type != "card"))'
    - '^https://api\.zhihu\.com/topstory/recommend\? response-jq .data[]?.children |= (if type == "array" then map(select(.id != "ring")) else . end)'
    - '^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? response-json-del third_business'
    - '^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? response-json-del ring_info'
    - '^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? response-json-del interaction_bar_plugins'
    - '^https://api\.zhihu\.com/podcasts/hub/v\d$ response-json-del banners'
    - '^https://api\.zhihu\.com/search_v\d\? response-json-del pendant'
    - '^https://api\.zhihu\.com/search/tabs\? response-jq .data |= map(select(.t | IN("general", "ai_zhida", "recent", "people", "zvideo", "ring", "topic", "podcast", "column", "pin", "favlist")))'
    - '^https://api\.zhihu\.com/people/self$ response-json-del vip_info.entrance_new.right_button'
    - '^https://api\.zhihu\.com/people/self$ response-json-del vip_info.entrance_v2'
    - '^https://api\.zhihu\.com/bazaar/vip_tab/header\? response-json-del activity_banner'
    - '^https://api\.zhihu\.com/bazaar/vip_tab/header\? response-json-del activity_window'
    - '^https://api\.zhihu\.com/bazaar/vip_tab/header\? response-json-del vip_tip'
    - '^https://api\.zhihu\.com/search/recommend_query/v2\? response-replace-regex recommend_queries:\{.+\} recommend_queries:{}'
    - '^https://api\.zhihu\.com/comment_v5/(answers|pins)/\d+/root_comment\? response-json-del atmosphere_voting_config'
    - '^https://api\.zhihu\.com/questions/\d+(?:/answers|/feeds|\?include=) response-jq del(.ad_info, .data.ad_info?, .query_info) | if (.data | type) == "array" then .data |= map(select(.target?.answer_type? // "" | tostring | contains("paid") | not)) else . end'
  mitm:
    - '*.zhihu.com'
    - 'zhihu.com'
  script:
    - name: 'zhihu'
      match: '^https://(?:api|page-info)\.zhihu\.com/(?:answers|articles)/v2/\d+'
      type: 'response'
    - name: 'zhihu'
      match: '^https://api\.zhihu\.com/commercial_api/app_float_layer'
      type: 'response'
    - name: 'zhihu'
      match: '^https://api\.zhihu\.com/feed/render/tab/config\?'
      type: 'response'
    - name: 'zhihu'
      match: '^https://api\.zhihu\.com/(?:moments_v3|topstory/hot-lists/total|topstory/recommend)'
      type: 'response'
    - name: 'zhihu'
      match: '^https://api\.zhihu\.com/root/tab'
      type: 'response'
    - name: 'zhihu'
      match: '^https://api\.zhihu\.com/v2/topstory/hot-lists/everyone-seeing\?'
      type: 'response'
    - name: 'zhihu'
      match: '^https://api\.zhihu\.com/next-(?:bff|data|render)'
      type: 'response'
    - name: 'zhihu'
      match: '^https://www\.zhihu\.com/api/v4/(?:articles|answers)/\d+/recommendations?\?'
      type: 'response'
    - name: 'zhihu'
      match: '^https://appcloud2\.zhihu\.com/v3/config'
      type: 'response'
    - name: 'zhihu'
      match: '^https://m-cloud\.zhihu\.com/api/cloud/zhihu/config/all\?'
      type: 'response'
rules:
  - 'DOMAIN, appcloud.zhihu.com, REJECT'
  - 'DOMAIN, appcloud2.in.zhihu.com, REJECT'
  - 'DOMAIN, crash2.zhihu.com, REJECT'
  - 'DOMAIN, lens.zhihu.com, REJECT'
  - 'DOMAIN, mqtt.zhihu.com, REJECT'
  - 'DOMAIN, sugar.zhihu.com, REJECT'
  - 'DOMAIN, zxid-m.mobileservice.cn, REJECT'
  - 'IP-CIDR, 103.41.167.237/32, REJECT, no-resolve'
  - 'IP-CIDR, 118.89.204.198/32, REJECT, no-resolve'
  - 'IP-CIDR, 182.61.194.7/32, REJECT, no-resolve'
  - 'IP-CIDR6, 2402:4e00:1200:ed00:0:9089:6dac:96b6/128, REJECT, no-resolve'
script-providers:
  zhihu:
    url: 'https://raw.githubusercontent.com/harmonizr/loon-plugins/main/scripts/rucu6.pages.dev/Scripts/zhihu.js'
    interval: 86400
