name: '红果短剧去广告'
desc: '红果短剧 去广告，拦截自有 SDK 与穿山甲等广告域。'
author: 'your98k'
homepage: 'https://github.com/Tartarus2014/Loon-Script'
icon: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/hongguoduanju.png
category: '去广告'
date: '2026-10-20'
version: '1.6.0'

rules:
  # 红果核心广告拦截
  - DOMAIN-SUFFIX,hongguoapp.com,REJECT
  - DOMAIN-SUFFIX,hongguosdk.com,REJECT
  - DOMAIN-KEYWORD,hongguo.ad,REJECT

  # 穿山甲与广告联盟 SDK（前两条与番茄覆写重复，有意保留）
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
  - DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
  - DOMAIN-SUFFIX,ad.pangle.cn,REJECT
  - DOMAIN-SUFFIX,ad.pangolin.cn,REJECT
  - DOMAIN-KEYWORD,ad-union-sdk,REJECT

  # 字节广告与埋点：只拦具体主机，不再整个 zijieapi.com 全域拒绝
  # （全域拒绝会连带打掉 tnc 配置下发、save 同步、polaris 等业务接口）
  - DOMAIN-KEYWORD,be-pack,REJECT
  - DOMAIN,ad.zijieapi.com,REJECT
  - DOMAIN-KEYWORD,ads3-normal,REJECT
  - DOMAIN-KEYWORD,ads5-normal,REJECT
  - DOMAIN-KEYWORD,applog.zijieapi.com,REJECT
  - DOMAIN,feedback-c.zijieapi.com,REJECT
  - DOMAIN-KEYWORD,tnc.snssdk,REJECT
