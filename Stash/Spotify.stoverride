name: 'Spotify 去广告'
desc: 'Spotify 去广告，拦截播放广告并补丁 Premium 状态，可单独关闭补丁排查跳歌。'
openUrl: 'https://apps.apple.com/app/id324684580'
author: 'your98k'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Spotify.png'
category: '去广告'
date: '2026-11-16'
version: '1.1.0'
arguments-version: 1
arguments:
  Enabled:
    type: switch
    title: 启用 Premium 补丁
    description: 关闭后只拦截播放广告接口，不打补丁。若开启时出现歌曲自动跳到下一首，可先关掉此项对比。
    default: true

http:
  mitm:
    - '*-spclient.spotify.com'
    - 'spclient.wg.spotify.com'
  url-rewrite:
    - '^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/pendragon/ - reject-dict'
  script:
    - name: 'spotify-crack'
      match: '^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/(?:bootstrap|user-customization-service)'
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 10
      engine: webkit
      argument: '{"Enabled":${args.Enabled|json}}'

script-providers:
  spotify-crack:
    url: 'https://raw.githubusercontent.com/your98k/Rule-Hub/main/Script/spotify-crack.js'
    interval: 86400
