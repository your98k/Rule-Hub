name: '米游社 去广告'
desc: '米游社 去广告，共 6 条规则。'
openUrl: 'https://apps.apple.com/app/id1470351334'
author: 'your98k'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

http:
  mitm:
    - 'bbs-api.miyoushe.com'
    - 'bbs-api-ab.miyoushe.com'
    - 'bbs-api-static.miyoushe.com'
  url-rewrite:
    - '^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppSplash$ - reject-dict'
    - '^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getHotKeywordAndEvent$ - reject-dict'
    - '^https://bbs-api-static\.miyoushe\.com/search/api/search/pre_keyword\? - reject-dict'
  body-rewrite:
    - '^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppStartupData$ response-jq del(.data.resp_map["/teenager/api/info"], .data.resp_map["/apihub/api/getAppConfig"].data.get_app_config_response.config.is_show_teenager_mode_btn, .data.resp_map["/apihub/api/getAppConfig"].data.get_app_config_response.config.teenager_popup_freq_type)'
    - '^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppConfig$ response-jq .data.config.teenager_popup_freq_type = 0 | .data.config.is_show_teenager_mode_btn = 0'
    - '^https://bbs-api-ab\.miyoushe\.com/teenager/api/info$ response-jq .data.is_enabled = false | .data.is_teenager = false | .data.is_force = false'
