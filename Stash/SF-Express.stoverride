name: '顺丰速运 去广告'
desc: |-
  移植 loonlab 插件仓库 SF-Express.lpx：6 条 url-rewrite、1 条 body-rewrite、1 条 mock，全部为 Stash 原生声明式配置。
  SF-Express 的 module-config mock 原始 text 含嵌套 JSON 字符串（引号未转义），无法直接作为合法 JSON，
  改为等价的空模块响应 {"version":"2.0","success":true,"obj":[]}。
  Loon 的 reject_dict/reject 映射为 reject-dict/reject，json.jq / json.delete / json.replace 分别映射为 response-jq / response-json-replace，body.mock 映射为 http.mock。
  覆盖 4 个域名，使用前请在 Stash 信任 MitM CA。
  来源：loonlab 插件仓库 SF-Express.lpx。
openUrl: 'https://apps.apple.com/app/id488113102'
author: 'loonlab · Loon→Stash 原生适配'
category: '去广告'
date: '2026-11-15'
version: '1.0.0'

http:
  mitm:
    - 'ccsp-egmas.sf-express.com'
    - 'ucmp.sf-express.com'
    - 'ucmp-static.sf-express.com'
    - 'mapi.sfbest.com'
  url-rewrite:
    - '^https://ccsp-egmas\.sf-express\.com/cx-app-base/base/app/ad/ - reject-dict'
    - '^https://ucmp\.sf-express\.com/proxy/esgcempcore/memberGoods/pointMallService/goodsList$ - reject-dict'
    - '^https?://ccsp-egmas\.sf-express\.com/cx-app-video/video/app/video/labelClusterList - reject-dict'
    - '^https?://ccsp-egmas\.sf-express\.com/cx-app-base/base/app/ad/queryInfoFlow - reject-dict'
    - '^https?://ccsp-egmas\.sf-express\.com/cx-app-base/base/app/bms/queryRecommend - reject-dict'
    - '^https?://mapi\.sfbest\.com/brokerservice-server/cms/getPositionById.* - reject'
  body-rewrite:
    - '^https://ccsp-egmas\.sf-express\.com/cx-app-base/base/app/appHomeConfig/query$ response-jq .obj |= map(select(.position != 2))'
  mock:
    - match: '^https://ucmp(-static)?\.sf-express\.com/proxy/ccspBase/module-config/(login/)?query\?'
      text: '{"version":"2.0","success":true,"obj":[]}'
      status-code: 200
      headers:
        Content-Type: 'application/json'
